relationship: OBI:0001938 uom:g ! has value specification gram

[Term]
id: PREFER:0000137
name: biomass formed variable
namespace: precision_fermentation
def: "A biomass balance metric that represents the cumulative quantity of cellular biomass generated in a bioreactor or fermentation system, during a fermentation process." []
synonym: "biomass formed calculated variable" EXACT []
synonym: "biomass production calculated variable" EXACT []
synonym: "biomass production variable" EXACT []
is_a: PREFER:0000161 ! biomass balance metric
relationship: OBI:0001938 PREFER:9000004 ! has value specification unit

[Term]
id: PREFER:0000138
name: transcriptomics sample calculated variable
def: "An omics sample calculated variable that represents transcript features derived from computational analysis using transcriptomics data from an offline sample associated with a process." []
is_a: PREFER:0000209 ! omics sample calculated variable

[Term]
id: PREFER:0000139
name: proteomics sample calculated variable
def: "An omics sample calculated variable that represents protein features derived from computational analysis using proteomic data from an offline sample associated with a fermentation process." []
is_a: PREFER:0000209 ! omics sample calculated variable

[Term]
id: PREFER:0000140
name: biomass formation rate variable
namespace: precision_fermentation
def: "A growth rate metric that represents the rate at which the biomass is formed over time in a bioreactor or fermentation system during a fermentation process." []
synonym: "biomass production rate variable" EXACT []
synonym: "Rx variable" EXACT OMO:0003012 []
is_a: PREFER:0000160 ! growth rate metric
relationship: OBI:0001938 PREFER:9000004 ! has value specification unit

[Term]
id: PREFER:0000141
name: fluxomics sample calculated variable
def: "An omics sample calculated variable that represents metabolic flux values derived from computational analysis using experimental data from an offline sample associated with a fermentation process." []
is_a: PREFER:0000209 ! omics sample calculated variable

[Term]
id: PREFER:0000142
name: specific biomass formation rate variable
namespace: precision_fermentation
def: "A growth rate metric that represents the rate of increase of biomass per unit of exisitng biomass, typically expressed as the fractional increase in biomass concentration per unit time, in a bioreactor or fermentation system during a fermentation process." []
synonym: "growth rate variable" EXACT []
synonym: "specific biomass production rate variable" EXACT []
synonym: "μ variable" EXACT OMO:0003012 []
is_a: PREFER:0000160 ! growth rate metric
relationship: OBI:0001938 uom:h-1 ! has value specification per hour (h⁻¹ or 1/h)

[Term]
id: PREFER:0000147
name: biomass yield (substrate) variable
namespace: precision_fermentation
def: "A process yield metric that represents the yield of biomass produced per substrate consumed, describing the efficiency of substrate conversion into biomass in a bioreactor or fermentation system, during a fermentation process." []
synonym: "biomass yield (S) variable" EXACT []
synonym: "Ysx variable" EXACT OMO:0003012 []
is_a: PREFER:0000155 ! process yield metric
relationship: OBI:0001938 PREFER:9000004 ! has value specification unit

[Term]
id: PREFER:0000148
name: metabolomics sample calculated variable
def: "An omics sample calculated variable that represents metabolite features derived from computational analysis using metabolomic data from an offline sample associated with a fermentation process." []
is_a: PREFER:0000209 ! omics sample calculated variable

[Term]
id: PREFER:0000149
name: metagenomics sample calculated variable
def: "A genomics sample calculated variable that represents metagenomic features derived from computational analysis using DNA sequence data from an offline sample associated with a fermentation process." []
is_a: PREFER:0000135 ! genomics sample calculated variable

[Term]
id: PREFER:0000150
name: data acquisition quality
namespace: precision_fermentation
def: "A quality that inheres in data or samples and specifies how, where, and when measurements are obtained in a bioreactor or fermentation system during the process." []
is_a: BFO:0000019 ! quality

[Term]
id: PREFER:0000151
name: inline data acquisition
namespace: precision_fermentation
def: "A data acquisition quality in which the analyzer or sensor is physically integrated into the bioreactor or process stream, allowing continuous measurement without removal of samples, typically providing high-frequency or real-time data for process monitoring and control." []
is_a: PREFER:0000150 ! data acquisition quality

[Term]
id: PREFER:0000152
name: online data acquisition
namespace: precision_fermentation
def: "A data acquisition quality in which samples are automatically withdrawn from the bioreactor or process stream and introduced into a measurement zone, with measurement results made available in near real time for monitoring and control. The analyzed sample may be discarded or returned to the process." []
is_a: PREFER:0000150 ! data acquisition quality

[Term]
id: PREFER:0000153
name: atline data acquisition
namespace: precision_fermentation
def: "A data acquisition quality in which samples are withdrawn from the process stream and transported a short distance to a nearby analytical device for measurement, involving a short delay between sampling and data availability. The analyzed sample is discarded and not returned to the process." []
synonym: "at-line data acquisition" EXACT []
is_a: PREFER:0000150 ! data acquisition quality

[Term]
id: PREFER:0000154
name: offline data acquisition
namespace: precision_fermentation
def: "A data acquisition quality in which samples are collected from the process and transported to an external laboratory or analysis location for measurement, with the sample not returned to the process line and with a significant delay between sampling and data availability." []
is_a: PREFER:0000150 ! data acquisition quality

[Term]
id: PREFER:0000155
name: process yield metric
namespace: precision_fermentation
def: "A key process metric that represents a quantitative metric, tipically expressed as yield coefficients, that quantify the efficiency of converting inputs(e.g. substrates) into desired outputs(e.g. products), expressed as the ratio of output formed per unit of substrate or biomass consumed." []
synonym: "key precision fermentation process yield metric" EXACT []
is_a: PREFER:0000078 ! key process metric

[Term]
id: PREFER:0000157
name: carbon balance metric
def: "A core balance metric that represents a quantitative metric derived from carbon balance calculations over a process, used to characterize the carbon flow within a bioreactor or fermenter system during the fermentation process." []
is_a: PREFER:0000023 ! core balance metric

[Term]
id: PREFER:0000158
name: respiratory rate metric
namespace: precision_fermentation
def: "A process rate metric variable that represents a rate describing respiratory activity of a production culture in a bioreactor or fermentation system during a fermentation process." []
synonym: "gas exchange metric" EXACT []
synonym: "metabolic metric" EXACT []
is_a: PREFER:0000000 ! process rate metric

[Term]
id: PREFER:0000159
name: bioproduction rate metric
namespace: precision_fermentation
def: "A process rate metric that represents a rate describing substrate consumptions, compound production (e.g. product formation) and biomass production in a bioreactor or fermentation system during a fermentation process." []
is_a: PREFER:0000000 ! process rate metric

[Term]
id: PREFER:0000160
name: growth rate metric
namespace: precision_fermentation
def: "A process rate metric that represents a rate describing biomass formation or growth in a bioreactor or fermentation system during a fermentation process." []
is_a: PREFER:0000000 ! process rate metric

[Term]
id: PREFER:0000161
name: biomass balance metric
def: "A core balance metric that represents a quantitative metric derived from biomass balance calculations over a process, used to characterize the balance of biomass output within a bioreactor or fermenter system during the fermentation fermentation process." []
is_a: PREFER:0000023 ! core balance metric

[Term]
id: PREFER:0000162
name: compound balance metric
def: "A core balance metric that represents a quantitative metric derived from compound balance calculations over a process, used to characterize the compound balabce within a bioreactor or fermenter system during the fermentation process." []
is_a: PREFER:0000023 ! core balance metric

[Term]
id: PREFER:0000180
name: operation mode control variable
namespace: precision_fermentation
def: "A precision fermentation process control variable that defines the operating stategy of a bioreactor or fermentation system, specifying how substrate, products and biomass are introduced, maintained, and removed during a fermentation process." []
synonym: "fermentation cultivation mode control variable" EXACT []
synonym: "operational mode control variable" BROAD []
synonym: "precision fermenation process feed control variable" EXACT []
is_a: PREFER:0000015 ! operational parameter
is_a: PREFER:9000000 ! precision fermentation process control variable

[Term]
id: PREFER:0000181
name: batch operation mode
namespace: precision_fermentation
def: "An operation mode control variable in which all required medium components and the inoculum are supplied at the start of the fermentation process, with no subsequent addition of medium components during operation, and in which products are harvested only at the end of the fermentation process." []
synonym: "batch bioprocess mode" EXACT []
synonym: "batch cell culture" RELATED [MSIO:0000181]
synonym: "batch cultivation" BROAD [PMID: 38806369]
synonym: "batch mode" BROAD []
is_a: PREFER:0000180 ! operation mode control variable

[Term]
id: PREFER:0000182
name: fed-batch operation mode
namespace: precision_fermentation
def: "An operation mode control variable in which additional nutrients, through feed medium, are intermittently or continuously supplied to the bioreactor or fermentar system during a fermentation process, without removal of production culture fluid, until termination of the fermentation process." []
synonym: "fed-batch cultivation" BROAD []
synonym: "fed-batch fermentation mode" EXACT []
synonym: "fed-batch mode" BROAD []
is_a: PREFER:0000180 ! operation mode control variable

[Term]
id: PREFER:0000183
name: continuous operation mode-chemostat
namespace: precision_fermentation
def: "An operation mode control variable in which fresh fermentation medium is supplied and fermentation culture fluid removed at a constant rate, such that the specific growth rate of the biomass is controlled by the limiting nutrient concentration and equals the dilution rate." []
synonym: "continuous fermentation mode, chemostat" EXACT []
synonym: "continuous mode, chemostat" BROAD []
is_a: PREFER:0000180 ! operation mode control variable

[Term]
id: PREFER:0000184
name: continuous operation mode-turbidostat
namespace: precision_fermentation
def: "An operation mode control variable in which fresh fermentation medium is supplied and fermentation culture fluid removed in response to feedback control, such that the biomass concentration is maintained constant at a predefined turbidity or optical density." []
synonym: "continuous fermentation mode, turbidostat" EXACT []
synonym: "continuous mode, turbidostat" BROAD []
is_a: PREFER:0000180 ! operation mode control variable

[Term]
id: PREFER:0000185
name: bioreactor scale
namespace: precision_fermentation
def: "A quality that inheres in a bioreactor and that characterizes its working volume, and used to classify bioreactors based on their intended application, ranging from laboratory research to industrial production." []
is_a: BFO:0000019 ! quality

[Term]
id: PREFER:0000186
name: laboratory bioreactor scale
namespace: precision_fermentation
def: "A bioreactor scale that refers to small volume bioreactor systems used for laboratory scale experimentation, research, development, and process optimization, typically ranging from a few milliliters to several liters in working volume." []
synonym: "bench bioreactor scale" EXACT []
synonym: "bench scale" EXACT []
synonym: "benchtop bioreactor scale" EXACT []
synonym: "benchtop scale" EXACT []
synonym: "lab bioreactor scale" EXACT []
synonym: "lab-scale" EXACT []
synonym: "laboratory scale" EXACT []
is_a: PREFER:0000185 ! bioreactor scale

[Term]
id: PREFER:0000187
name: pilot bioreactor scale
namespace: precision_fermentation
def: "A bioreactor scale that serves as an intermediate step between laboratory scale and industrial scale, typically ranging from several liters to a few hundred liters in working volume." []
synonym: "pilont plant bioreactor scale" EXACT []
synonym: "pilot-scale" EXACT []
synonym: "pre pilot plant-scale" EXACT []
synonym: "pre pilot-scale" EXACT []
synonym: "pre-pilot plant bioreactor scale" NARROW []
is_a: PREFER:0000185 ! bioreactor scale

[Term]
id: PREFER:0000188
name: industrial bioreactor scale
namespace: precision_fermentation
def: "A bioreactor scale used for large-scale production, typically ranging from several hundred liters to thousands of liters or more in working volume." []
synonym: "industrial scale" EXACT []
synonym: "industrial-scale" EXACT []
is_a: PREFER:0000185 ! bioreactor scale

[Term]
id: PREFER:0000189
name: feed profile type control variable
namespace: precision_fermentation
def: "The feeding strategies typically found in a fed-batch or continuous fermentation types." []
comment: The type of feeding profiles applied is process specific.
synonym: "feed profile type" EXACT []
synonym: "feeding profile" EXACT []
synonym: "feeding strategy" EXACT []
is_a: PREFER:0000009 ! feed control variable
is_a: PREFER:0000015 ! operational parameter

[Term]
id: PREFER:0000190
name: constant feeding rate
namespace: precision_fermentation
def: "A feed profile type control variable in which the feed rate is maintained at a constant value throughout the feeding phase." []
is_a: PREFER:0000189 ! feed profile type control variable

[Term]
id: PREFER:0000191
name: linear feeding rate
namespace: precision_fermentation
def: "A feed profile type control variable in which the feed rate changes linearly with time throughout the feeding phase." []
is_a: PREFER:0000189 ! feed profile type control variable

[Term]
id: PREFER:0000192
name: exponential feeding rate
namespace: precision_fermentation
def: "A feed profile type control variable in which the feed rate increases exponentially with time throughout the feeding phase." []
is_a: PREFER:0000189 ! feed profile type control variable

[Term]
id: PREFER:0000193
name: constant-linear feeding rate
namespace: precision_fermentation
def: "A feed profile type control variable in which the feed rate begins at a constant rate and subsequently transitions to a linearly changing feed rate with time throughout the feeding phase." []
is_a: PREFER:0000189 ! feed profile type control variable

[Term]
id: PREFER:0000194
name: constant-exponential feeding rate
namespace: precision_fermentation
def: "A feed profile type control variable in which the feed rate begins at a constant rate and subsequently transitions to a exponentially increasing feed rate with time throughout the feeding phase." []
is_a: PREFER:0000189 ! feed profile type control variable

[Term]
id: PREFER:0000195
name: exponential-linear feeding rate
namespace: precision_fermentation
def: "A feed profile type control variable in which the feed rate begins with an exponentially increasing rate and subsequently transitions to a linearly changing feed rate with time throughout the feeding phase." []
is_a: PREFER:0000189 ! feed profile type control variable

[Term]
id: PREFER:0000200
name: fermentation culture role
namespace: precision_fermentation
def: "A role that inheres in a fermentation culture and that involves the culture participating in, enabling or initiating a fermentation process." []
is_a: BFO:0000023 ! role

[Term]
id: PREFER:0000203
name: production culture
namespace: precision_fermentation
def: "A fermentation culture role that is involved in carrying out the main fermentation process to generate the desired product or cell biomass." []
synonym: "main culture" EXACT []
is_a: PREFER:0000200 ! fermentation culture role

[Term]
id: PREFER:0000204
name: unpublished strain
namespace: precision_fermentation
def: "An isolate or group of isolates that have not been published (it is not available in deposits or collections nor do you know the strain history) and hence do not yet have a universal identifier." []
comment: Unpublished strain is a quality used to tag strains that do not yet have a universal identifier. If or when they get published, this tag should be removed. All strains should still be under taxon. Strain and subtype are often used interchangeably, although the term strain is often used to describe a set of isolates with common biochemical and/or physiological characteristics, while the term subtype is often used to describe a set of isolates with common genetic or molecular characteristics. {xref="doi:10.1093/jaoac/85.2.524"}
is_a: BFO:0000019 ! quality

[Term]
id: PREFER:0000205
name: cell culture
namespace: precision_fermentation
def: "A material entity consisting of prokaryotic or eukaryotic living cells, whether unicellular or multicellular, that are maintaned, cultivated, or propagated under controlled environmental conditions." []
xref: ENVO:02000008
xref: OBI:0001876
is_a: BFO:0000040 ! material entity
relationship: BFO:0000051 CL:0000000 ! has part cell

[Term]
id: PREFER:0000206
name: microbial culture
namespace: precision_fermentation
def: "A material entity consisting of microorganisms-unicellular microbial cell cultures- either prokaryotic (such as bacteria, archaea, or cyanobactreia) or eukaryotic (such as yeast, microalgae and protozoa), that are maintaned, cultivated, or propagated under controlled environmental conditions." []
synonym: "microbiological culture" EXACT []
is_a: BFO:0000040 ! material entity
relationship: BFO:0000051 CL:0000000 ! has part cell
property_value: oboInOwl:synoymn "microbial cell culture" xsd:string

[Term]
id: PREFER:0000207
name: tissue culture
namespace: precision_fermentation
def: "A material entity consisting of multicellular tissue, such as plant tissue cultures, animal cell-derived tissue cultures (including mammalian), or cultures of filamentous fungi, that is maintaned, cultivated, or propagated under controlled environmental conditions." []
is_a: BFO:0000040 ! material entity
relationship: BFO:0000051 CL:0000000 ! has part cell

[Term]
id: PREFER:0000209
name: omics sample calculated variable
def: "A precision fermentation process calculated variable that represents a set of values derived from computational analysis or omics data procesing from an offline sample associated with a fermentation process." []
synonym: "calculated omics offline sample variable" EXACT []
synonym: "computed omics offline sample variable" EXACT []
synonym: "computed omics sample variable" EXACT []
is_a: PREFER:9000002 ! precision fermentation process calculated variable

[Term]
id: PREFER:7000000
name: mole per carbon mole
namespace: precision_fermentation
def: "A unit representing a mol-based ratio, typically used to express product, output substance or input - such as compound and substrate -  in moles per carbon mole of biomass(X) generated or substrate(S) consumed (mol/cmol)." []
synonym: "mol/c-mol" EXACT []
synonym: "mol/cmol" EXACT []
synonym: "mole per carbon mole" RELATED []
is_a: PREFER:9000004 ! unit
relationship: PREFER:8000021 PREFER:7000002 ! has denominator unit carbon mole
relationship: PREFER:8000022 uom:mol ! has numerator unit mole

[Term]
id: PREFER:7000001
name: mole per carbon mole per hour
namespace: precision_fermentation
def: "A unit representing a compound rate, expressed as moles per carbon mole(X) per hour ((mol/cmol)/h)." []
synonym: "(mol/c-mol)/h" EXACT []
synonym: "(mol/cmol)/h" EXACT []
synonym: "mole per carbon mole per hour" RELATED []
is_a: PREFER:9000004 ! unit
relationship: PREFER:8000021 uom:h ! has denominator unit hour
relationship: PREFER:8000022 PREFER:7000000 ! has numerator unit mole per carbon mole

[Term]
id: PREFER:7000002
name: carbon mole
namespace: precision_fermentation
def: "Semantically equivalent in magnitude to the SI mole (1 C-mol = 1 mol) but used to indicate mole of carbon atoms (cmol)." []
synonym: "C-mol" EXACT []
synonym: "carbon mole" RELATED []
synonym: "cmol" EXACT []
synonym: "mole of carbon atoms" EXACT []
is_a: PREFER:9000004 ! unit

[Term]
id: PREFER:7000003
name: carbon mole per gram
namespace: precision_fermentation
def: "A unit representing a carbon-based ratio, typically used to express product or output substance - such as biomass or compound - in carbon moles per gram of initial material or input substrate consumed (cmol/g)." []
synonym: "c-mol/g" EXACT []
synonym: "carbon mole per gram" RELATED []
synonym: "cmol/g" EXACT []
