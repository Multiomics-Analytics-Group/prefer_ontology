! ============================
! 2. New Terms for PREFER
! These terms are needed for relationships in PREFER
! ============================

[Term]
id: PREFER:0000180
name: operational mode
synonym: "cultivation mode" EXACT [PREFER]
synonym: "mode of cultivation" EXACT [PREFER]
synonym: "mode of operation" EXACT [PREFER] 
def: "A defined strategy of operating a bioreactor that specifies how culture medium and biomass are introduced, maintained, and removed over time." [PREFER]

[Term]
id: PREFER:0000181
name: batch
def: "An operational mode in which all nutrients are supplied at the start of cultivation, with no further input or removal of medium until the end of the process." [PREFER]
synonym: "batch culture" EXACT []
synonym: "batch cell culture" EXACT [MSIO:0000181]
synonym: "batch cutivation" EXACT [PMID: 38806369]
is_a: PREFER:0000180 ! operational mode
xref: MSIO:0000181 ! batch cell culture {source "MSIO:0000181"}

[Term]
id: PREFER:0000182
name: fed-batch
def: "An operational mode in which additional nutrients are intermittently or continuously supplied to the culture during cultivation, without removal of culture fluid, until termination of the process." [PREFER]
is_a: PREFER:0000180 ! operational mode

[Term]
id: PREFER:0000183
name: continuous-chemostat
def: "A continuous operational mode in which fresh medium is supplied and culture fluid removed at a constant rate, such that the specific growth rate of the biomass is controlled by the limiting nutrient concentration and equals the dilution rate." [PREFER]
is_a: PREFER:0000180 ! operational mode

[Term]
id: PREFER:0000184
name: continuous-turbidostat
def: "A continuous operational mode in which fresh medium is supplied and culture fluid removed in response to feedback control, such that the biomass concentration is maintained constant at a predefined turbidity or optical density." [PREFER]
is_a: PREFER:0000180 ! operational mode

[Term]
id: PREFER:0000185
name: bioreactor scale
def: "A classification of bioreactors based on culture volume and intended application, ranging from laboratory research to industrial production." [PREFER]

[Term]
id: PREFER:0000186
name: lab-scale
def: "A bioreactor scale typically used for small-scale experiments and research, ranging from a few milliliters to several liters in volume." [PREFER]
comment: "For instance, minibioreactors (50-500 mL) such as Ambr or Pioreactors, or micro bioreactors (< 10 mL) fall within this category." [PREFER]   
is_a: PREFER:0000185 ! bioreactor scale

[Term]
id: PREFER:0000187
name: pilot-scale
def: "A bioreactor scale that serves as an intermediate step between lab-scale and industrial-scale, typically ranging from several liters to a few hundred liters in volume." [PREFER]
is_a: PREFER:0000185 ! bioreactor scale

[Term]
id: PREFER:0000188
name: industrial-scale
def: "A bioreactor scale used for large-scale production, typically ranging from several hundred liters to thousands of liters or more in volume." [PREFER]
is_a: PREFER:0000185 ! bioreactor scale

[Term]
id: PREFER:0000189
name: feed profile
def: "The feeding strategies typically found in a fed-batch fermentation type. The type of feeding profiles applied is process specific." [PREFER]
synonym: "feeding profile" EXACT []
synonym: "feed stream profile" NARROW []
synonym: "feeding strategy" EXACT []
relationship: PREFER_RE:refers_to_variable PREFER:0000037 ! feed

[Term]
id: PREFER:0000190
name: constant feeding rate
def: "" [PREFER]
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000191
name: linear feeding rate
def: "" [PREFER]
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000192
name: exponential feeding rate
def: "" [PREFER]
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000193
name: constant-linear feeding rate
def: "" [PREFER]
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000194
name: constant-exponential feeding rate
def: "" [PREFER]
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000195
name: exponential-linear feeding rate
def: "" [PREFER]
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000200
name: fermentation culture type
def: "" [PREFER]

[Term]
id: PREFER:0000201
name: pre-optional culture
def: "The first ssed, optional, usually cultivated in a flask." [PREFER]
is_a: PREFER:0000200 ! culture type

[Term]
id: PREFER:0000202
name: pre-final culture
def: "The second seed, usually cultivated in a flask but it could also be in a bioreactor." [PREFER]
is_a: PREFER:0000200 ! culture type

[Term]
id: PREFER:0000203
name: main culture
def: "The culture seed used for the actual experiment, usually in a bioreactor." [PREFER]
is_a: PREFER:0000200 ! culture type

[Term]
id: PREFER:0000204
name: strain
def: "An isolate or group of isolates that can be distinguished from other isoletes of the same species by phenotypic and/or genotypic characteristics." [doi:10.1093/jaoac/85.2.524, PREFER]
comment: "Strain and subtype are often used interchangeably, although the term strain is often used to describe a set of isolates with common biochemical and/or physiological characteristics, while the term subtype is often used to describe a set of isolates with common genetic or molecular characteristics." [doi:10.1093/jaoac/85.2.524, PREFER]
synonym: "subtype" EXACT [doi:10.1093/jaoac/85.2.524]
is_a: NCBITaxon:_taxonomic_rank ! taxonomic rank
xref: NCBITaxon:strain ! strain {source:"NCBI Taxonomy"}

[Term]
id: PREFER:0000205
name: cell culture
def: 
xref: ENVO:02000008 ! cell culture {source:"The Environment Ontology, Version 2025-08-19"}

[Term]
id: PREFER:0000206
name: microbial culture
def: "A culture consisting of live microbial cells or microorganisms, such as bacteria, yeast, or fungi, used in bioprocesses for various applications including precision fermentation, bioremediation, and production of biofuels and pharmaceuticals." [PREFER]
synonym: "microbiological culture" EXACT []
!is_a: PREFER:0000205 ! cell culture
!xref: NCBITaxon:2 ! Bacteria {source:"NCBI Taxonomy"}
!xref: NCBITaxon:strain ! strain {source:"NCBI Taxonomy"}

[Term]
id: PREFER:0000207
name: tissue culture
def: "A culture consisting of live plant or animal cells (including mammalian cells), used in bioprocesses for various applications including precision fermentation, bioremediation, and production of biofuels and pharmaceuticals." [PREFER]
!is_a: PREFER:0000205 ! cell culture
!xref: NCBITaxon:33208 ! Metazoa {source:"NCBI Taxonomy"}
