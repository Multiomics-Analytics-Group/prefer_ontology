AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0200190> "clustered data visualization")
SubClassOf(<http://purl.obolibrary.org/obo/OBI_0200190> <http://purl.obolibrary.org/obo/OBI_0200111>)
