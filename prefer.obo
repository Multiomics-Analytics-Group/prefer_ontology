relationship: refers_to_variable PREFER:0000038 ! pH
relationship: setpoint_of PREFER:0000040 ! pH measurement

[Term]
id: PREFER:0000021
name: pH base solution
def: "The alkaline (base) solution automatically added during the fermentation run to control and maintain the pH at the defined setpoint." [PREFER]
synonym: "pH control base solution" EXACT []
is_a: SIO:000000 ! entity
relationship: refers_to_variable PREFER:0000038 ! pH

[Term]
id: PREFER:0000022
name: pH acid solution
def: "The acidic solution automatically added during the fermentation run to control and maintain the pH at the defined setpoint." [PREFER]
synonym: "pH control acid solution" EXACT []
relationship: PREFER_RE:refers_to_variable PREFER:0000038 ! pH

