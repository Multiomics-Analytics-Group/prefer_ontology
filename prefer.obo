[Term]
id: PREFER:0000079
name: carbon balance variable
namespace: precision_fermentation
def: "A carbon balance metric that represents the general carbon balance, which compares the total amount of carbon entering a bioreactor or fermenter system (through the substrate) to the total carbon leaving the system (through products, biomass or by-products)." []
synonym: "C balance variable" EXACT OMO:0003012 []
