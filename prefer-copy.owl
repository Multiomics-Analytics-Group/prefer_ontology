############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/PREFER_0000001> (precision fermentation process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PREFER") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PREFER_0000001> "A biotechnological method used in industrial or research settings that employs genetically engineered or adaptatively evolved(ALE) microorganisms (such as bacteria, yeast, fungi or microalgae) to produce specific, high-value compounds with precise molecular structures. This process involves controlled environments—such as operating bioreactor parameters(e.g., temperature, pH, dissolved oxygen, agitation, nutrient feed) and upstream preparation conditions(e.g., pre-culture growth, strain storage, and defined media composition)—where microbial metabolism is optimized to synthesize target products, such as proteins, enzymes, or bioactive molecules, often with greater efficiency, yield, and specificity than traditional fermentation methods.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PREFER_0000001> "GO:0006113")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PREFER_0000001> "OBI_0000011")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PREFER_0000001> "SRAO_/SRAO:0000223")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PREFER_0000001> "Wikipedia:Industrial_fermentation#Precision_fermentation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PREFER_0000001> "precision_fermentation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PREFER_0000001> "PREFER:0000001")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PREFER_0000001> "\"Root of all fermentation terms in the Precision Fermentation Ontology.\"")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PREFER_0000001> "precision fermentation process")
