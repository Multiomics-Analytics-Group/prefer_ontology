[Term]
id: PREFER:0000034
name: starting OD
def: "The initial optical density (OD) of the fermentation. It is either measured (by taking a sample after inoculation and measuring the cell density spectophotometrically at 600nm or 900nm wavelength) or  calculated (by knowing the final OD of the seed culture, volume inoculated and final cultivation volume)." [PREFER]
is_a: PREFER:0000009 ! process variable
!is_a: PREFER:000000X ! output variable # Can be calculated from process variables
relationship: PREFER_RE:refers_to_variable PREFER:0000039 ! OD # or Biomass?
relationship: PREFER_RE:has_unit NCIT:C73681 ! unit of optical density

[Term]
id: PREFER:0000035
name: final seed OD
def: "The cell density of the seed culture for the actual experiment at the time it is inoculated to the bioreactor." [PREFER]
synonym: "final seed culture OD" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:refers_to_variable PREFER:0000010 ! fermentation culture # or seed term?
relationship: PREFER_RE:refers_to_variable PREFER:0000039 ! OD # or Biomass?
relationship: PREFER_RE:has_unit NCIT:C73681 ! unit of optical density

