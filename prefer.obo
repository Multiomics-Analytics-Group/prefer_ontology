relationship: setpoint_of PREFER:0000040 ! pH measurement

[Term]
id: PREFER:0000021
name: pH base solution
def: "The alkaline (base) solution automatically added during the fermentation run to control and maintain the pH at the defined setpoint." [PREFER]
synonym: "pH control base solution" EXACT []
relationship: refers_to_variable PREFER:0000038 ! pH

[Term]
id: PREFER:0000022
