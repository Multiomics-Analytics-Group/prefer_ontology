[Term]
id: PREFER:0000020
name: pH setpoint
def: "Target pH value to be maintained within the fermenter throught the process." [PREFER]
synonym: "pH control setpoint" EXACT [PREFER]
synonym: "ph control setpoint" EXACT [PREFER]
synonym: "ph setpoint" EXACT [PREFER]
synonym: "target pH" EXACT [PREFER]
synonym: "target ph" EXACT [PREFER]
