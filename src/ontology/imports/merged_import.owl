AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0000707> "decision tree building data transformation"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBI_0000707> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000417> <http://purl.obolibrary.org/obo/OBI_0000704>))
