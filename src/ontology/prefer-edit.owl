AnnotationAssertion(rdfs:label obo:PREFER_8000018 "has operational mode"@en)

# Object Property: obo:PREFER_8000020 (setpoint of)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_8000020 "x is setpoint_of y iff x and y are information content entities, and x is a specified numerical value or target parameter that defines the desired state or threshold that y is designed to regulate, maintain, or reference.")
