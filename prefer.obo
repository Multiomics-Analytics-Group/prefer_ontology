relationship: PREFER_RE:has_unit PREFER_UNIT:0000163 ! carbon mole per carbon mole


! ============================
! 1. New Terms for PREFER
! These terms are needed for relationships in PREFER
! ============================

[Term]
id: PREFER:0000150
name: data acquisition mode
def: "How, where, and when process data or samples are collected and measured during a bioprocess. The modes included are inline, online, atline, and offline." [PREFER]

[Term]
id: PREFER:0000151
name: inline measurement
def: "The analyzer is integrated into the bioreactor and the measurement is taken continuosly into the bioreactor. The sample flows continuously through the analyzer. The measurament is real-time with high frequency data, enabling real-time process monitoring and control." [PREFER]
is_a: PREFER:0000150 ! data acquisition mode

[Term]
id: PREFER:0000152
name: online measurement
def: "Analysis method that extracts a sample from the bioreactor and introduces it into the measurement zone. Sample can either be discarded or returned to the bioreactor." [PREFER]
is_a: PREFER:0000150 ! data acquisition mode

[Term]
id: PREFER:0000153
name: atline measurement
def: "Analysis method that extracts a sample from the process line and transporte it to a nerby analyzer. There is delay between sampling and measurment." [PREFER]
is_a: PREFER:0000150 ! data acquisition mode

[Term]
id: PREFER:0000154
name: offline measurement
def: "Analysis method that collects a sample from the process line and transports it to the analyzis laboratory. The sample is not returned to the process line." [PREFER]
is_a: PREFER:0000150 ! data acquisition mode

***********************************
[Term]
id: PREFER:0000155
name: performance variable
def: "Computed variables that assess bioprocess efficiency, suchas as yields, rates, respiratorymetrics, and balance metrics." [PREFER]
!is_a: PREFER:000000X ! computed variable # derived omic output

[Term]
id: PREFER:0000156
name: yield
def: "Computed variable that quantifies the efficiency of converting substrates into desired outputs, expressed as the ratio of the output formed per unit of substrate consumed." [PREFER]
is_a: PREFER:0000155 ! performance variable

[Term]
id: PREFER:0000157
name: rate
def: "Computed variable that quantifies the speed of bioprocess activities, measuring the change of a process variable over time." [PREFER]
is_a: PREFER:0000155 ! performance variable

[Term]
id: PREFER:0000158
name: respiratory metric
def: "Computed variable that quantifies respiratory activity in the bioprocess, providing indications of metabolic states and gas exchange efficiency." [PREFER]
comment: "For instance, oxygen uptake rate (OUR), carbon dioxide evolution rate (CER), respiratory quotient (RQ), and related metrics."
synonym: "metabolic metric" EXACT []
is_a: PREFER:0000155 ! performance variable

[Term]
id: PREFER:0000159
name: production metric
!def: "Computed variable that assesses the consistency of material balances in the bioprocess, by comparing the total inputs and outoputs of specific compounds." [PREFER]
comment: "For instance, product yields, productivity rates"
is_a: PREFER:0000155 ! performance variable

[Term]
id: PREFER:0000160
name: growth metric
!def: "Computed variable, typically derived from cultivation conditions and process variables, that quantifies the outputs of the bioprocess, including products, by-products, and biomass." [PREFER]
comment: "For instance, specific growth rate, biomass yields."
!is_a: phenomics
!is_a: omics output
!is_a: output variable
***************************


! ============================
! Custom Units for PREFER
! These unit terms extend UO for use in PREFER
! ============================

[Term]
id: PREFER_UNIT:0000161
name: gram per gram
def: "A unit representing a mass ratio, typically used to express product or output substance - such as biomass or compound -  in grams per gram of initial material, input substrate consumed(S), or biomass(X) generated(cell dry weight(CDW))(g/g)." [PREFER]
synonym: "Gram per Gram" EXACT []
synonym: "g/g" EXACT []
xref: NCIT:C70453 ! Gram per Gram {source:"NCI Thesaurus OBO Edition"}
is_a: UO:0000190 ! ratio unit

[Term]
id: PREFER_UNIT:0000162
name: carbon mole per gram
def: "A unit representing a carbon-based ratio, typically used to express product or output substance - such as biomass or compound - in carbon moles per gram of initial material or input substrate consumed (cmol/g)." [PREFER]
synonym: "cmol/g" EXACT []
synonym: "c-mol/g" EXACT []
is_a: UO:0000190 ! ratio unit
relationship: PREFER_RE:has_numerator_unit PREFER_UNIT:0000164 ! carbon mole 
relationship: PREFER_RE:has_denominator_unit UO:0000021 ! gram 

[Term]
id: PREFER_UNIT:0000163
name: carbon mole per carbon mole
def: "A unit representing a carbon-based ratio, typically used to express product, output substance or input - such as biomass, compound and substrate -  in carbon moles per carbon mole of biomass generated, initial material consumed or input substrate consumed (cmol/cmol)." [PREFER]
synonym: "cmol/cmol" EXACT []
synonym: "c-mol/c-mol" EXACT []
is_a: UO:0000190 ! ratio unit
relationship: PREFER_RE:has_numerator_unit PREFER_UNIT:0000164 ! carbon mole
relationship: PREFER_RE:has_denominator_unit PREFER_UNIT:0000164 ! carbon mole 

[Term]
id: PREFER_UNIT:0000164
name: carbon mole
def: "Semantically equivalent in magnitude to the SI mole (1 C-mol = 1 mol) but used to indicate mole of carbon atoms (cmol)." [PREFER]
synonym: "mole of carbon atoms" EXACT []
synonym: "C-mol" EXACT []
synonym: "cmol" EXACT []
is_a: CHEBI:64708 ! one-carbon compound {source:"ChEBI"}
relationship: PREFER_RE:has_unit UO:0000013 ! mole 

[Term]
id: PREFER_UNIT:0000165
name: mole per carbon mole
comment: "A unit representing a mol-based ratio, typically used to express product, output substance or input - such as compound and substrate -  in moles per carbon mole of biomass(X) generated or substrate(S) consumed (mol/cmol)." [PREFER]
synonym: "mol/cmol" EXACT []
synonym: "mol/c-mol" EXACT []
is_a: UO:0000190 ! ratio unit
relationship: PREFER_RE:has_numerator_unit UO:0000013 ! mole 
relationship: PREFER_RE:has_denominator_unit PREFER_UNIT:0000164 ! carbon mole 

[Term]
id: PREFER_UNIT:0000167
