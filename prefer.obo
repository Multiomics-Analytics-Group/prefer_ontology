is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000156 ! Yield

[Term]
id: PREFER:0000097
name: O2 decimal
def: "The decimal fraction of O2 in a gas stream, representing the proportion of O2 in the exhaust gas relative to the total gas volume, no units."
is_a: PREFER:0000017 ! Computed variable

[Term]
id: PREFER:0000098
name: Oxygen partial integration
def: "A time-based integration of O2 production, often calculated for specific time intervals??????, no units."
is_a: PREFER:0000017 ! Computed variable

[Term]
id: PREFER:0000099
name: Oxygen accumulated
def: "The total amount of O2 consumed and measured over the course of the bioprocess, tracked as an accumulated value, no units"
is_a: PREFER:0000017 ! Computed variable

[Term]
id: PREFER:0000100
