[Term]
id: PREFER:0000106
name: oxygen yield (biomass) variable
namespace: precision_fermentation
def: "A process yield metric variable that represents the yield of oxygen consumed per biomass (X), describing how much oxygen is consumed relative to the amount of biomass generated in a bioreactor or fermentation system, during the process." []
