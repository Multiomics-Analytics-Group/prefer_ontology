AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:33817343") obo:IAO_0000115 obo:PREFER_8000049 "An organisation that is an integrated molecular biology facility that includes robotic liquid-handling equipment, high-throughput analytical equipment, and the software, personnel and data management systems required to run the equipment and broader biofoundry capabilities.")
AnnotationAssertion(rdfs:label obo:PREFER_8000049 "Biofoundry"@en)
SubClassOf(obo:PREFER_8000049 obo:OBI_0000245)

# Class: obo:PREFER_8000053 (Growth Profiler 960 - Enzyscreen bioreactor)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://www.enzyscreen.com/article/How-does-it-work/") obo:IAO_0000115 obo:PREFER_8000053 "A microbioreactor-scale bioreactor produced by Enzyscreen that cultivates and optically monitors up to 960 microbial or cell cultures simultaneously in ten 96-square-well microtiter plates (MTPs), each with a culture volume of 0.25 mL. the system combines orbital shaking incubation with time-resolved bottom imaging and automated image-based biomass quantification.")
AnnotationAssertion(rdfs:label obo:PREFER_8000053 "Growth Profiler 960 - Enzyscreen bioreactor"@en)
SubClassOf(obo:PREFER_8000053 obo:PREFER_0000014)
SubClassOf(obo:PREFER_8000053 ObjectSomeValuesFrom(obo:PREFER_8000008 obo:PREFER_0000085))

# Class: obo:PREFER_8000054 (TOM - Kuhner bioreactor)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://kuhner.com/wAssets/docs/download/Maschinendokumentation/Information-Flyer-KuhnerTOM-en-_2025.pdf") obo:IAO_0000115 obo:PREFER_8000054 "A bench-scale shaken bioreactor online monitoring system produced by Kuhner that enables parallel monitoring of up to 16 individual shake flasks. The system measures oxygen transfer rate (OTR), carbon dioxide transfer rate (CTR), and respiratory quotient (RQ) through automated analysis of respiratory gas exchange during orbital shaking incubation.")
AnnotationAssertion(rdfs:comment obo:PREFER_8000054 "This system is classified under bioreactor because of its use in conjunction with biological cultivation workflows. However, the Kuhner TOM is not strictly a bioreactor. Rather, it is an online respiratory gas monitoring and analytical system that measures oxygen transfer rate (OTR), carbon dioxide transfer rate (CTR), and respiratory quotient (RQ) in cultures grown in orbitally shaken vessels such as shake flasks.")
AnnotationAssertion(rdfs:label obo:PREFER_8000054 "TOM - Kuhner bioreactor"@en)
SubClassOf(obo:PREFER_8000054 obo:PREFER_0000014)
SubClassOf(obo:PREFER_8000054 ObjectSomeValuesFrom(obo:PREFER_8000008 obo:PREFER_0000186))

# Class: obo:PREFER_8000055 (Livit Flex - Getinge bioreactor)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://www.getinge.com/int/products/livit-flex/") obo:IAO_0000115 obo:PREFER_8000055 "A bench-scale bioreactor bioprocess control system produced by Getinge that monitors and regulates cultivation parameters in connected single-use or reusable bioreactors through integrated control software, sensor interfaces, fluid handling components, and gas management functions. It can be configured as single or dual control system with vessel total volumes ranging from 2 to 20 L.")
AnnotationAssertion(rdfs:comment obo:PREFER_8000055 "Former manufacturer is Applikon Biotechnology")
AnnotationAssertion(rdfs:comment obo:PREFER_8000055 "This system is classified as a bioreactor due to its use in conjunction with biological cultivation workflows. However, the Livit Flex is not strictly a bioreactor. Rather, it is a bioprocess control system that enables customizable configurations for efficient control and optimization of fermentation processes.")
AnnotationAssertion(rdfs:label obo:PREFER_8000055 "Livit Flex - Getinge bioreactor"@en)
SubClassOf(obo:PREFER_8000055 obo:PREFER_0000014)
SubClassOf(obo:PREFER_8000055 ObjectSomeValuesFrom(obo:PREFER_8000008 obo:PREFER_0000186))

# Class: obo:PREFER_8000056 (BioBench - Biostream bioreactor)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://www.biostream-international.com/biobench/") obo:IAO_0000115 obo:PREFER_8000056 "A bench-scale stirred-tank bioreactor produced by Biostream with a working volume of approximately 5 liters, integrated with the Lucullus process information management platform for automated monitoring, control, and data acquisition during biological cultivation processes.")
AnnotationAssertion(rdfs:label obo:PREFER_8000056 "BioBench - Biostream bioreactor"@en)
SubClassOf(obo:PREFER_8000056 obo:PREFER_0000014)
