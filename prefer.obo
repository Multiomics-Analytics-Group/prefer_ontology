name: linear feeding rate
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000192
name: exponential feeding rate
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000193
name: constant-linear feeding rate
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000194
name: constant-exponential feeding rate
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000195
name: exponential-linear feeding rate
is_a: PREFER:0000189 ! feed profile

[Term]
id: PREFER:0000200
name: fermentation culture type
is_a: SIO:000000 ! entity

[Term]
id: PREFER:0000201
name: pre-optional culture
def: "The first ssed, optional, usually cultivated in a flask." [PREFER]
is_a: PREFER:0000200 ! fermentation culture type

[Term]
id: PREFER:0000202
name: pre-final culture
def: "The second seed, usually cultivated in a flask but it could also be in a bioreactor." [PREFER]
is_a: PREFER:0000200 ! fermentation culture type

[Term]
id: PREFER:0000203
name: main culture
def: "The culture seed used for the actual experiment, usually in a bioreactor." [PREFER]
is_a: PREFER:0000200 ! culture type

[Term]
id: PREFER:0000204
name: strain
def: "An isolate or group of isolates that can be distinguished from other isoletes of the same species by phenotypic and/or genotypic characteristics." [doi:10.1093/jaoac/85.2.524, PREFER]
comment: "Strain and subtype are often used interchangeably, although the term strain is often used to describe a set of isolates with common biochemical and/or physiological characteristics, while the term subtype is often used to describe a set of isolates with common genetic or molecular characteristics." [doi:10.1093/jaoac/85.2.524, PREFER]
synonym: "subtype" EXACT [doi:10.1093/jaoac/85.2.524]
is_a: NCBITaxon:_taxonomic_rank ! taxonomic rank
xref: NCBITaxon:strain ! strain {source:"NCBI Taxonomy"}

[Term]
id: PREFER:0000205
name: cell culture
def: 
xref: ENVO:02000008 ! cell culture {source:"The Environment Ontology, Version 2025-08-19"}

[Term]
id: PREFER:0000206
name: microbial culture
def: "A culture consisting of live microbial cells or microorganisms, such as bacteria, yeast, or fungi, used in bioprocesses for various applications including precision fermentation, bioremediation, and production of biofuels and pharmaceuticals." [PREFER]
synonym: "microbiological culture" EXACT []
!is_a: PREFER:0000205 ! cell culture
!xref: NCBITaxon:2 ! Bacteria {source:"NCBI Taxonomy"}
!xref: NCBITaxon:strain ! strain {source:"NCBI Taxonomy"}

[Term]
id: PREFER:0000207
name: tissue culture
def: "A culture consisting of live plant or animal cells (including mammalian cells), used in bioprocesses for various applications including precision fermentation, bioremediation, and production of biofuels and pharmaceuticals." [PREFER]
!is_a: PREFER:0000205 ! cell culture
!xref: NCBITaxon:33208 ! Metazoa {source:"NCBI Taxonomy"}

[Term]
id: PREFER:0000208
name: omics
def: "The collective characterisation and quantification of pools of biological molecules that translate into the structure, function, and dynamics of an organism or organisms." [EDAM]
synonym: "Omics" EXACT [PREFER]
xref: EDAM:3391 ! omics {source: "EDAM - The ontology of data analysis and management"}

[Term]
id: PREFER:0000209
name: genomics
def: "Whole genomes of one or more organisms, or genomes in general, such as meta-information on genomes, genome projects, gene names etc." [EDAM]
synonym: "Genomics" EXACT [PREFER]
xref: EDAM:0622 ! genomics {source: "EDAM - The ontology of data analysis and management"}
!is_a: EDAM:3391 ! omics {source: "EDAM - The ontology of data analysis and management"}
is_a: PREFER:0000208 ! omics

[Term]
id: PREFER:0000210
name: transcriptomics
def: "The analysis of transcriptomes, or a set of all the RNA molecules in a specific cell, tissue etc." [EDAM]
synonym: "Transcriptomics" EXACT [PREFER]
xref: EDAM:3308 ! transcriptomics {source: "EDAM - The ontology of data analysis and management"}
is_a: PREFER:0000208 ! omics

[Term]
id: PREFER:0000211
name: proteomics
def: "Protein and peptide identification, especially in the study of whole proteomes of organisms." [EDAM]
synonym: "Proteomics" EXACT [PREFER]
xref: EDAM:0121 ! proteomics {source: "EDAM - The ontology of data analysis and management"}
is_a: PREFER:0000208 ! omics

[Term]
id: PREFER:0000212
name: metabolomics
def: "The systematic study of metabolites, the chemical processes they are involved, and the chemical fingerprints of specific cellular processes in a whole cell, tissue, organ or organism." [EDAM]
synonym: "Metabolomics" EXACT [PREFER]
xref: EDAM:3172 ! metabolomics {source: "EDAM - The ontology of data analysis and management"}
is_a: PREFER:0000208 ! omics

[Term]
id: PREFER:0000213
name: phenomics
def: "Phenomes, or the study of the change in phenotype (the physical and biochemical traits of organisms) in response to genetic and environmental factors." [EDAM]
synonym: "Phenomics" EXACT [PREFER]
xref: EDAM:3298 ! phenomics {source: "EDAM - The ontology of data analysis and management"}
is_a: PREFER:0000208 ! omics

[Term]
id: PREFER:0000214
name: fluxomics
def: "Experimental approaches to determine the rates of metabolic reactions - the metabolic fluxes - within a biological entity." [EDAM]
comment: "The fluxome is the complete set of metabolic fluxes in a cell, and is a dynamic aspect of phenotype." [EDAM]
synonym: "Fluxomics" EXACT [PREFER]
xref: EDAM:3955 ! fluxomics {source: "EDAM - The ontology of data analysis and management"}
is_a: PREFER:0000208 ! omics