synonym: "o2 yield (S) variable" EXACT []
synonym: "oxygen yield (S) variable" EXACT []
is_a: PREFER:0000155 ! process yield metric
relationship: BAO_0002874 PREFER:9000004 ! unit

[Term]
id: PREFER:0000105
