# Object Property: obo:PREFER_8000000 (has fermentation experiment)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_8000000 "inverse of is fermentation experiment of.")
AnnotationAssertion(rdfs:label obo:PREFER_8000000 "has fermentation experiment"@en)
SubObjectPropertyOf(obo:PREFER_8000000 obo:BFO_0000051)
InverseObjectProperties(obo:PREFER_8000000 obo:PREFER_8000001)
TransitiveObjectProperty(obo:PREFER_8000000)

# Object Property: obo:PREFER_8000001 (is fermentation experiment of)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_8000001 "x is_fermentation_experiment_of y iff x is a fermentation experiment, y is a precision fermentation process, and x is part of y.")
AnnotationAssertion(rdfs:label obo:PREFER_8000001 "is fermentation experiment of"@en)
SubObjectPropertyOf(obo:PREFER_8000001 obo:BFO_0000050)
TransitiveObjectProperty(obo:PREFER_8000001)
ObjectPropertyDomain(obo:PREFER_8000001 obo:PREFER_0000003)
ObjectPropertyRange(obo:PREFER_8000001 obo:PREFER_9000003)

