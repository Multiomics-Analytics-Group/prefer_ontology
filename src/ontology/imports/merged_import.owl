AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0002328> "Stage IA1 (FIGO)")
ClassAssertion(<http://purl.obolibrary.org/obo/OBI_0002326> <http://purl.obolibrary.org/obo/OBI_0002328>)

