SubClassOf(<http://www.bioassayontology.org/bao#BAO_0000362> <http://www.bioassayontology.org/bao#BAO_0000510>)

# Class: <http://www.bioassayontology.org/bao#BAO_0000509> (eukaryote)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://www.bioassayontology.org/bao#BAO_0000509> "This includes fungi, vertebrates and invertebrates. Eukaryotic cells have a well-defined nucleus and membrane enveloped organelles namely, mitochondria, endoplasmic reticulum, golgi apparatus, and lysosomes.")
AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0000509> "eukaryote")
SubClassOf(<http://www.bioassayontology.org/bao#BAO_0000509> <http://www.bioassayontology.org/bao#BAO_0000658>)

# Class: <http://www.bioassayontology.org/bao#BAO_0000510> (vertebrate)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://www.bioassayontology.org/bao#BAO_0000510> "This includes animals having a vertebral column, and model organisms from this group include the zebrafish, mouse, rat, etc")
AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0000510> "vertebrate")
SubClassOf(<http://www.bioassayontology.org/bao#BAO_0000510> <http://www.bioassayontology.org/bao#BAO_0000659>)

# Class: <http://www.bioassayontology.org/bao#BAO_0000551> (organism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://www.bioassayontology.org/bao#BAO_0000551> "The organism related to the target / meta-target of the bioassay. It includes both bacterium and eukaryote.")
AnnotationAssertion(rdfs:label <http://www.bioassayontology.org/bao#BAO_0000551> "organism")
