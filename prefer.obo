relationship: PREFER_RE:has_unit UO:0000189 ! dimensionless unit

[Term]
id: PREFER:0000127
name: carbon dioxide accumulated downscaled
def: "The total molar quantity of CO2 generated." [PREFER]
synonym: "co2 accumulated downscaled" EXACT []
is_a: PREFER:0000160 ! output variable
relationship: PREFER_RE:has_unit UO:0000013 ! mole

[Term]
id: PREFER:0000128
name: carbon dioxide Q
def: "The volumetric rate of CO2 produced by the bioprocess over time." [PREFER]
synonym: "co2 Q" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit PREFER_UNIT:0000167 ! liters per hour

[Term]
id: PREFER:0000129
name: carbon dioxide evolution rate
def: "The total rate at which CO2 is produced per unit of biomass (X), reflecting overall process performance, how efficiently CO2 is released from a fermenter system." [PREFER]
synonym: "co2 evolution rate" EXACT []
synonym: "CER" EXACT []
is_a: PREFER:0000157 ! rate
relationship: has_unit PREFER_UNIT:0000173 ! mole per carbon mole per hour

[Term]
id: PREFER:0000130
name: specific carbon dioxide evolution rate
def: "The specific rate at which CO2 is produced normalized per unit of biomass (X), allowing metabolic efficiency comparisions between cultures." [PREFER]
synonym: "specific co2 evolution rate" EXACT []
synonym: "specific CER" EXACT []
is_a: PREFER:0000157 ! rate
relationship: has_unit PREFER_UNIT:0000173 ! mole per carbon mole per hour

[Term]
id: PREFER:0000131
name: carbon dioxide yield (S)
def: "The yield of CO2 produced per mole of substrate consumed (S), quantifying how much CO2 is produced relative to the substrate consumed in the bioprocess." [PREFER]
synonym: "co2 yield (S)" EXACT []
is_a: PREFER:0000156 ! yield
relationship: PREFER_RE:has_unit PREFER_UNIT:0000176 ! mole per mole
relationship: PREFER_RE:has_unit PREFER_UNIT:0000165 ! mole per carbon mole

[Term]
id: PREFER:0000133
name: carbon dioxide yield (X)
def: "The yield of CO2 produced per carbon mole of biomass (X), describing how much CO2 is produced relative to the amount of biomass generated." [PREFER]
synonym: "co2 yield (X)" EXACT []
is_a: PREFER:0000156 ! yield
relationship: PREFER_RE:has_unit PREFER_UNIT:0000165 ! mole per carbon mole

[Term]
id: PREFER:0000134
name: biomass amount
def: "The absolute quantity of cellular biomass present in a system at a given time point." [PREFER]
is_a: PREFER:0000160 ! output variable
relationship: PREFER_RE:has_unit UO:0000021 ! gram
relationship: PREFER_RE:has_unit UO:0000013 ! mole

[Term]
id: PREFER:0000136
name: biomass lost in sampling
def: "The amount of biomass removed from the bioreactor during sampling." [PREFER]
is_a: PREFER:0000160 ! output variable
relationship: PREFER_RE:has_unit UO:0000021 ! gram

[Term]
id: PREFER:0000137
name: biomass production
def: "The cumulative quantity of cellular biomass generated over a defined cultivation period." [PREFER]
synonym: "biomass formed" EXACT []
is_a: PREFER:0000160 ! output variable
relationship: PREFER_RE:has_unit UO:0000021 ! gram
relationship: PREFER_RE:has_unit UO:0000013 ! mole
relationship: PREFER_RE:has_unit PREFER_UNIT:0000168 ! carbon mole

[Term]
id: PREFER:0000140
name: biomass production rate
def: " The rate at which the biomass is produced over time." [PREFER]
synonym: "Rx" EXACT []
synonym: "Biomass formation rate" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit PREFER_UNIT:0000169 ! gram per hour
relationship: PREFER_RE:has_unit PREFER_UNIT:0000170 ! mole per hour
relationship: PREFER_RE:has_numerator_unit PREFER_UNIT:0000175 ! carbon mole per hour

[Term]
id: PREFER:0000142
name: specific growth rate
def: "The rate of increase of biomass per unit of exisitng biomass, typically expressed as the fractional increase in biomass concentration per unit time." [PREFER]
synonym: "μ" EXACT []
synonym: "specific biomass growth rate" EXACT []
synonym: "growth rate" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit QUDT:PER-HR ! per hour

[Term]
id: PREFER:0000143
name: average specific biomass growth rate in feed phase
def: "The average specific growth rate of biomass during the feeding phase." [PREFER]
synonym: "μ mean in feed" EXACT []
synonym: "μ mean in feed phase" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit QUDT:PER-HR ! per hour

[Term]
id: PREFER:0000144
name: average specific biomass growth rate in batch phase
def: "The average specific growth rate of biomass during the batch phase." [PREFER]
synonym: "μ mean in batch" EXACT []
synonym: "μ mean in batch phase" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit QUDT:PER-HR ! per hour

[Term]
id: PREFER:0000145
name: maximum specific biomass growth rate in feed phase
def: "The maximum specific growth rate of biomass during the feeding phase." [PREFER]
synonym: "μ max in feed" EXACT []
synonym: "μ max in feed phase" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit QUDT:PER-HR ! per hour

[Term]
id: PREFER:0000146
name: minimum specific biomass growth rate in feed phase
def: "The minimum specific growth rate of biomass during the feeding phase." [PREFER]
synonym: "μ min in feed" EXACT []
synonym: "μ min in feed phase" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_unit QUDT:PER-HR ! per hour

[Term]
id: PREFER:0000147
name: biomass yield (S)
def: "The biomass produced per substrate consumed, describing the efficiency of substrate conversion into biomass." [PREFER]
synonym: "Ysx" EXACT []
synonym: "S" EXACT []
is_a: PREFER:0000156 ! yield
relationship: PREFER_RE:has_unit PREFER_UNIT:0000161 ! gram per gram
