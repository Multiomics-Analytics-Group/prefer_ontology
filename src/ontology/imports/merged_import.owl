AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0002330> "Stage IB (FIGO)")
ClassAssertion(<http://purl.obolibrary.org/obo/OBI_0002326> <http://purl.obolibrary.org/obo/OBI_0002330>)

