relationship: PREFER_RE:has_collected PREFER:0000018 ! offline sample

[Term]
id: PREFER:0000005
name: cultivation condition
def: ""
synonym: "fermentation condition" BROADER [DOI: 10.15252/embr.202152680]
xref: EDAM:3724 ! cultivation parameter {source="Ontology of data analysis and management"}
is_a: XCO:0000000 ! experimental condition {source="Experimental Condition Ontology"}
relationship: has_part PREFER:0000006 ! operational parameter

[Term]
id: PREFER:0000006
name: operational parameter
!def: "An environmental setting or an initial experimental condition related to inoculation established prior to the start of a fermentation process." [PREFER]
!comment: "This condition, which may be categorical or scalar variable, can include key environmental setpoints such as pH, temperature, initial volume, and optical density (OD) of the seed culture."
def: "An operational setting related to the operational mode of the bioreactor and the type of fermentation or cultivation carried out." [PREFER]
comment: "Such as dissolved oxygen (DO) control setpoints and feeding strategies." [PREFER]
synonym: "operational setting" RELATED []
synonym: "bioreactor control setting" RELATED []
synonym: "target variable" RELATED []
synonym: "reference value" RELATED []
synonym: "setpoint value" RELATED []
synonym: "setting" RELATED [AFR:0001505]
synonym: "parameter" RELATED [NCIT:C44175, REPR:Parameter]
xref: REPR:InstrumentSetting ! instrument setting
xref: AFO_/property#AFX:0001732 ! reference value {source="Allotrope Foundation Ontology Merged Without QUDT And Inferred (REC/2025/06)"}


[Term]
id: PREFER:0000007
name: process variable
def: "A technical parameter measured during a bioprocess, either through real-time (online, inline) or delayed (offline, atline) measurements, depending on the bioreactor setup. These variables are typically time-series data and are crucial for controlling and adjusting the initial parameters from cultivation conditions." [PREFER]
comment: "These data typically include compound groups categorized as substrates, products, by-products, and chemical ingredients from the medium."
synonym: "bioprocess measured variable" EXACT []
synonym: "bioprocess variable" EXACT []
xref: BAO:0002070
is_a: SIO:000000 ! entity
property_value: BROADER "bioprocess observed variable" xsd:string
property_value: BROADER "measured variable" xsd:string
property_value: BROADER "observed variable" xsd:string
property_value: BROADER "variable" xsd:string

[Term]
id: CHEBI:24431 
name: chemical entity
def:  "A chemical substance produced or consumed, whose concentration is monitored during the course of the fermentation, typically by withdrawing samples from the culture broth and measuring it using offline instrumentation, such as High-Performance Liquid Chromatography (HPLC)." [PREFER]
synonym: "compound" EXACT []
!*************

[Term]
id: PREFER:0000011
name: medium
def: "An aqueous solution containing macronutrients, micronutrients and buffering agents." [PREFER]
synonym: "culture medium" EXACT [OBI:0000079]
xref: BAO:0000114
xref: EFO:0000579
xref: OBI:0000079
is_a: SIO:000000 ! entity
relationship: has_ingredient CHEBI:24431 ! chemical entity

[Term]
id: PREFER:0000012
name: cell biocatalyst
def: "A living cell used as a catalyst for bioproduction. In a biotransformation process or bioprocess, it converts substrates (organic or inorganic compounds) into outputs such as products, by-products, and cell biomass. Energy derived from substrate conversion is used for product formation, growth and cellular maintencance." [PREFER]
synonym: "whole-cell biocatalyst" EXACT [DOI: 10.1186/s12934-017-0724-7]
synonym: "WCB" EXACT [DOI: 10.1201/9781003413134]
synonym: "biological catalyst" EXACT [PREFER]
synonym: "biocatalyst" EXACT [PREFER]
synonym: "cell factory" EXACT [PREFER]
synonym: "cell catalyst" EXACT [PREFER]
synonym: "microbial cell factory" NARROW [PREFER]
synonym: "catalyst" BROAD [PREFER]
!is_a: PREFER:0000013 ! taxon
relationship: PREFER_RE:is_cell_culture_type PREFER:0000206 ! microbial culture
relationship: PREFER_RE:is_cell_culture_type PREFER:0000207 ! tissue culture

[Term]
id: PREFER:0000013
name: taxon
def: "A specific biological classification(taxonomy) within the database, generally species, but it could also be genus, family, order, class, phylum, kingdom, and domain." [PREFER]
is_a: NCBITaxon:131567 ! cellular organisms
xref: NCBITaxon:1 ! root

[Term]
id: PREFER:0000014
name: bioreactor
def: "A device or system that supports a biologically active environemnt to run a bioprocess, including lab-scale, pilot plant, and industrial-scale systems." [OBI:0001046, PREFER]
synonym: "bioreactor system" EXACT []
synonym: "fermenter" NARROW [MSIO:0000167]
xref: OBI:0001046
is_a: BAO_0003118 ! instrument
relationship: has_operational_mode PREFER:0000181 ! batch
relationship: has_operational_mode PREFER:0000182 ! fed-batch
relationship: has_operational_mode PREFER:0000183 ! continuous-chemostat
relationship: has_operational_mode PREFER:0000184 ! continuous-turbidostat
relationship: has_scale PREFER:0000186 ! lab-scale
relationship: has_scale PREFER:0000187 ! pilot-scale
relationship: has_scale PREFER:0000188 ! industrial-scale

[Term]
id: PREFER:0000016
name: phase
def: "A time interval of a fermentation process." [PREFER]
is_a: SIO:000000 ! entity

[Term]
id: PREFER:0000017
name: event
def: "An operational intervention set by user that triggers the start or end of the fermentation phase." [PREFER]
is_a: SIO:000000 ! entity

[Term]
id: PREFER:0000018
name: offline sample
def: "A sample taken from the bioreactor at a specific time point during the fermentation run for subsequent offline analysis of various compounds, such as substrates, products, and by-products, and biomass." [PREFER]
synonym: "collected sample" EXACT []
synonym: "sample" EXACT [SIO]
is_a: SIO:001050 ! sample

[Term]
