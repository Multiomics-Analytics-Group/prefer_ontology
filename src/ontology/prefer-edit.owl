# Class: obo:PREFER_0000151 (inline data acquisition)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_0000151 "A data acquisition quality in which the analyzer or sensor is physically integrated into the bioreactor or process stream, allowing continuous measurement without removal of samples, typically providing high-frequency or real-time data for process monitoring and control.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000151 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000151 "PREFER:0000151")
AnnotationAssertion(rdfs:label obo:PREFER_0000151 "inline data acquisition")
SubClassOf(obo:PREFER_0000151 obo:PREFER_0000150)

# Class: obo:PREFER_0000152 (online data acquisition)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_0000152 "A data acquisition quality in which samples are automatically withdrawn from the bioreactor or process stream and introduced into a measurement zone, with measurement results made available in near real time for monitoring and control. The analyzed sample may be discarded or returned to the process.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000152 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000152 "PREFER:0000152")
AnnotationAssertion(rdfs:label obo:PREFER_0000152 "online data acquisition")
SubClassOf(obo:PREFER_0000152 obo:PREFER_0000150)

# Class: obo:PREFER_0000153 (atline data acquisition)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_0000153 "A data acquisition quality in which samples are withdrawn from the process stream and transported a short distance to a nearby analytical device for measurement, involving a short delay between sampling and data availability. The analyzed sample is discarded and not returned to the process.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PREFER_0000153 "at-line data acquisition")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000153 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000153 "PREFER:0000153")
AnnotationAssertion(rdfs:label obo:PREFER_0000153 "atline data acquisition")
SubClassOf(obo:PREFER_0000153 obo:PREFER_0000150)

# Class: obo:PREFER_0000154 (offline data acquisition)

AnnotationAssertion(obo:IAO_0000115 obo:PREFER_0000154 "A data acquisition quality in which samples are collected from the process and transported to an external laboratory or analysis location for measurement, with the sample not returned to the process line and with a significant delay between sampling and data availability.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000154 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000154 "PREFER:0000154")
AnnotationAssertion(rdfs:label obo:PREFER_0000154 "offline data acquisition")
SubClassOf(obo:PREFER_0000154 obo:PREFER_0000150)

