format-version: 1.2
data-version: prefer/releases/v0_2025-08-28
default-namespace: precision_fermentation
ontology: prefer.obo
property_value: dc:creator "Alberto Santos" xsd:string
property_value: dc:creator "Txell Amigó" xsd:string
property_value: dc:title "PREFER Ontology" xsd:string
property_value: dc:description "An ontology for PREcision FERmentation" xsd:string
property_value: terms:license "https://creativecommons.org/licenses/by/4.0/"

[Term]
id: PREFER:0000001
name: precision fermentation process
def: "A biotechnological method used in industrial or research settings that employs genetically engineered or adaptatively evolved(ALE) microorganisms (such as bacteria, yeast, or fungi) to produce specific, high-value compounds with precise molecular structures. This process involves controlled environments—such as operating bioreactor parameters(e.g., temperature, pH, dissolved oxygen, agitation, nutrient feed) and upstream preparation conditions(e.g., pre-culture growth, strain storage, and defined media composition)—where microbial metabolism is optimized to synthesize target products, such as proteins, enzymes, or bioactive molecules, often with greater efficiency, yield, and specificity than traditional fermentation methods." [PREFER]
comment: "Root of all fermentation terms in the Precision Fermentation Ontology."
xref: GO:0006113 ! fermentation
xref: Wikipedia:Industrial_fermentation#Precision_fermentation
xref: OBI_0000011 ! planned process

[Term]
id: PREFER:0000002
name: fermentation run
def: "An individual instance of a precision fermentation process carried out under defined experimental conditions (e.g., temperature, pH, agitation) using a single bioreactor system." [PREFER]
synonym: "run" EXACT []
part_of: PREFER:0000003 ! fermentation experiment
relationship: PREFER_RE:has_measured_cultivation_condition PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:has_measured_process_variable PREFER:0000009 ! process variable
relationship: PREFER_RE:has_medium PREFER:0000011 ! medium
relationship: PREFER_RE:cultures_strain PREFER:0000012 ! strain
relationship: PREFER_RE:uses_fermenter PREFER:0000014 ! fermenter
relationship: PREFER_RE:has_measured_compound PREFER:0000010 ! compound
relationship: PREFER_RE:has_measured_imodulon PREFER:0000017 ! iModulon

[Term]
id: PREFER:0000003
name: fermentation experiment
def: "A set of fermentation runs conducted within the same project, all following a shared experimental approach or protocol." [PREFER]
synonym: "experiment" EXACT []
has_part: PREFER:0000002 ! fermentation run
is_a: PREFER:0000001 ! precision fermentation process
xref: OBI_0000070 ! assay

[Term]
id: PREFER:0000004
name: fermentation project
def: "A single fermentation experiment or multiple related experiments conducted within a research group." [PREFER]
synonym: "project" EXACT []
has_part: PREFER:0000003 ! fermentation experiment
is_a: PREFER:0000001 ! precision fermentation process
xref: OBI_0000066 ! investigation

! ============================
![Term]
!id: PREFER:0000005
!name: user
!def: "The individual assigned as the project manager."
!is_a: PREFER:0000001 ! precision fermentation process

![Term]
!id: PREFER:0000006
!name: institution
!def: "The public or private research center, university, or organization that hosts or supports the execution of the project."

![Term]
!id: PREFER:0000007
!name: country
!def: "The state or nation where the project is carried out."
!is_a: PREFER:0000001 ! precision fermentation process
! ============================

[Term]
id: PREFER:0000008
name: cultivation condition
def: "An initial experimental parameter or environmental setting established prior to or at the start of a fermentation process." [PREFER]
comment: "This condition, which may be categorical or scalar variable, can include key environmental setpoints such as pH, temperature, initial volume, and optical density (OD) of the seed culture, as well as operational parameters like dissolved oxygen (DO) control setpoints and feeding strategies."
synonym: "variable" RELATED []
xref: BAO_0002070 ! measured value

[Term]
id: PREFER:0000009
name: process variable
def: "A technical parameter measured during a bioprocess, either through real-time (online, inline) or delayed (offline, atline) measurements, depending on the bioreactor setup. These variables are typically time-series data and are crucial for controlling and adjusting the initial parameters from cultivation conditions." [PREFER]
comment: "These data typically include compound groups categorized as substrates, products, by-products, and chemical ingredients from the medium."
synonym: "variable" RELATED []
xref: BAO_0002070 ! measured value

[Term]
id: PREFER:0000010
name: compound
def:  "A chemical substance produced or consumed, whose concentration is monitored during the course of the fermentation, typically by withdrawing samples from the culture broth and culture broth and measuring it using offline instrumentation, such as High-Performance Liquid Chromatography (HPLC)." [PREFER]
is_a: CHEBI:24431 ! chemical entity

[Term]
id: PREFER:0000011
name: medium
def: "An aqueous solution containing macronutrients, micronutrients and buffering agents." [PREFER]
relationship: PREFER_RE:has_ingredient PREFER:0000010 ! compound
xref: EFO:0000579 ! media

[Term]
id: PREFER:0000012
name: strain
def: "A distinct microbial strain within the database." [PREFER]
is_a: NCBITaxon:_taxonomic_rank ! taxonomic rank
xref: NCBITaxon:strain

[Term]
id: PREFER:0000013
name: taxon
def: "A specific taxa within the database, generally species, but it could also be genus, family, order, class, phylum, kingdom, and domain." [PREFER]
is_a: NCBITaxon:131567 ! cellular organisms
xref: NCBITaxon:1 ! root

[Term]
id: PREFER:0000014
name: fermenter
def: "Concrete type of bioreactor environment where the fermentation occurs." [PREFER]
synonym: "bioreactor" EXACT []
synonym: "bioreactor system" EXACT []
is_a: BAO:0003118 ! instrument
xref: OBI:0001046 ! bioreactor

[Term]
id: PREFER:0000015
name: phase
def: "A time interval of a fermentation process." [PREFER]

[Term]
id: PREFER:0000016
name: event
def: "A fermentation event that triggers the fermentation phase to start or end." [PREFER]

! ============================
![Term]
!id: PREFER:0000018
!name: input variable
!def: "Computed variable, typically derived from cultivation conditions and process variables, that quantifies the inputs of the bioprocess, including substrates, and gases such as oxygen or hydrogen."
!synonym: "input var" EXACT []
! ============================

[Term]
id: PREFER:0000019
name: temperature setpoint
def: "The target temperature value to be maintained within the fermenter." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000041 ! temperature 
relationship: PREFER_RE:has_possible_unit: UO:0000027 ! degree Celsius
relationship: PREFER_RE:has_possible_unit: UO:0000195 ! degree Fahrenheit

[Term]
id: PREFER:0000020
name: pH setpoint
def: "Target pH value to be maintained within the fermenter throught the process." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000040 ! pH
relationship: PREFER_RE:has_possible_unit: UO:0000196 ! pH  

[Term]
id: PREFER:0000021
name: pH control base solution
def: "The alkaline (base) solution used to control and maintain the pH within the fermenter, when it reaches below the setpoint." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 

[Term]
id: PREFER:0000022
name: pH control acid solution
def: "The acidic solution used to control and maintain the pH within the fermenter, when it rises above the setpoint." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 

[Term]
id: PREFER:0000023
name: culture
def: "Starter culture id or initial culture referring to the strain ID." [PREFER]
is_a: PREFER:0000008 ! cultivation condition

[Term]
id: PREFER:0000024
name: seed
def: "Starter culture or initial culture prepared from a stock culture and cultivated in smaller volume (either tubes, shake flasks or reactors) until a certain concentration is reached. The starter culture is also referred as a seed culture, pre-culture or inoculum." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000022 ! culture 

[Term]
id: PREFER:0000025
name: DO control setpoint
def: "The target value for dissolved oxygen." [PREFER]
synonym: "dissolved oxygen control setpoint" EXACT []
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_possible_unit: UO:0000187 ! percent

[Term]
id: PREFER:0000026
name: DO control cascade level 1
def: "First level of the cascade control system for dissolved oxygen. Level 1 involves adjusting the stirrer_speed parameter to ahcieve the desired DO level." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000027
name: maximum stirring
def: "The maximum revolutions per minute (rpm) of the bioreactor stirrer." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
synonym: "maximum shaking speed" EXACT []
relationship: related_to PREFER:0000039 ! DO
relationship: PREFER_RE:has_possible_unit: UO:0000079 ! radian per second 

[Term]
id: PREFER:0000028
name: minimum stirring
def: "The minimum revolutions per minute (rpm) of the bioreactor stirrer." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
synonym: "minimum shaking speed" EXACT []
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_possible_unit: UO:0000079 ! radian per second 

[Term]
id: PREFER:0000029
name: DO control cascade level 2
def: "Second level of the cascade control system for dissolved oxygen. Level 2 involves adjusting the air flow parameter to ahcieve the desired DO level." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000030
name: aeration gas type
def: "Type of gas used for aeration in the bioreactor, which may include aire or specific gases such as pure oxygen or nitrogen." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000031
name: maximum aeration
def: "Maximum rate of at which gas can be supplied to the fermenter, measured in slpm (standard liters per minute)." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000032
name: minimum aeration
def: "Minimum rate of at which gas can be supplied to the fermenter, measured in slpm (standard liters per minute)." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000033
name: DO control cascade level 3
def: "Third level of the cascade control system for dissolved oxygen. Level 3 involves adjusting the oxygen flow parameter to ahcieve the desired DO level." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000034
name: starting OD
def: "The initial optical density (OD) of the fermentation. It is either measured (by taking a sample after inoculation and measuring the cell density spectophotometrically at 600 nm) or  calculated (by knowing the final OD of the seed culture, volume inoculated and final cultivation volume)." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000060 ! OD 
relationship: PREFER_RE:has_possible_unit: SNOMED:258743006 ! optical density units

[Term]
id: PREFER:0000035
name: final seed OD
def: "The cell density of the seed culturre at the time it is inoculated to the main fermenter." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000060 ! OD 
relationship: PREFER_RE:has_possible_unit: SNOMED:258743006 ! optical density units

[Term]
id: PREFER:0000036
name: initial culture volume
def: "The total volume of the culture at the beginning of the bioprocess, representing the sum of culture medium and inoculum." [PREFER]
is_a: PREFER:0000008 ! cultivation condition
relationship: PREFER_RE:related_to PREFER:0000022 ! culture 
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter 
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter 

[Term]
id: PREFER:0000038
name: feed profile
def: "Feeding strategies typically found in a fed-batch fermentation. 1. Constant feeding rate, 2. Linear feeding rate and 3. Exponential feeding rate, 4. Combination of 1-2, 3-2 or 3-1 . The type of feeding profiles applied is process specific." [PREFER]
is_a: PREFER:0000008 ! cultivation condition

[Term]
id: PREFER:0000039
name: DO
def: "Concentration of oxygen molecules (O₂) dissolved in the aqueous fermentation medium." [PREFER]
synonym: "dissolved oxygen" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000189 ! dimensionless unit

[Term]
id: PREFER:0000040
name: pH
def: "Bioreactor Potential of Hydrogen (pH) reading. pH is the negative decadic logarithm of the hydrogen ion concentration in aqueous solution, here the fermentation medium." [REFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000196 ! pH
relationship: PREFER_RE:has_possible_unit: UO:0000189 ! dimensionless unit

[Term]
id: PREFER:0000041
name: temperature
def: "Bioreactor temperature reading." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000027 ! degree Celsius
relationship: PREFER_RE:has_possible_unit: UO:0000195 ! degree Fahrenheit

[Term]
id: PREFER:0000042
name: pressure
def: "Bioreactor pressure reading." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit QUDT:BAR ! bar
relationship: PREFER_RE:has_possible_unit: UO:0000110 ! pascal

[Term]
id: PREFER:0000043
name: volume
def: "Total volume of aqueous solution in the fermenter." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter

[Term]
id: PREFER:0000044
name: sample mass
def: "The mass of the sample taken from a single run to quantify the amount of biomass, product, and other compounds." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000154 ! offline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000021 ! gram
relationship: PREFER_RE:has_possible_unit: UO:0000022 ! milligram

[Term]
id: PREFER:0000045
name: sample volume
def: "The volume of the sample taken from a single run to calculate concentrations, dilutions, etc." [PREFER]
is_a: PREFER:00000XX ! intermediate variable
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter

[Term]
id: PREFER:0000046
name: accumulated sample volume
def: "Total volume of all samples taken from a single run up to a certain point in time." [PREFER]
is_a: PREFER:00000XX ! intermediate variable
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter

[Term]
id: PREFER:0000047
name: acid volume
def: "Volume of the acidic solution added into the fermenter to maintain the pH of cultivation at a constant level." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter

[Term]
id: PREFER:0000048
name: base volume
def: "Volume of the basic solution added into the fermenter to maintain the pH of cultivation at a constant level." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter

[Term]
id: PREFER:0000049
name: acid rate
def: "The flow rate at which the acid solution is added into the fermenter." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000167 ! liters per hour

[Term]
id: PREFER:0000050
name: base rate
def: "The flow rate at which the base solution is added into the fermenter." [REFER]
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000167 ! liters per hour

[Term]
id: PREFER:0000051
name: feed amount
def: "The quantity of feed added to the bioprocess at a certain time point." [PREFER]
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:related_to PREFER:0000038 ! feed profile
relationship: PREFER_RE:has_possible_unit: UO:0000009 ! kilogram
relationship: PREFER_RE:has_possible_unit: UO:0000021 ! gram

[Term]
id: PREFER:0000052
name: feed volume
def: "The volume of the feed solution added to the bioprocess at a certain time point." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000099 ! liter
relationship: PREFER_RE:has_possible_unit: UO:0000098 ! milliliter

[Term]
id: PREFER:0000053
name: feed rate volumetric 
def: "Rate at which the feed (based on its volume) is added to the bioprocess." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000167 ! liters per hour

[Term]
id: PREFER:0000054
name: stirrer speed 
def: "Speed at which the impeller shaft rotates." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000079 ! radian per second 

[Term]
id: PREFER:0000055
name: air flow
def: "Rate at which air is supplied to the fermenter." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! online measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000172 ! liters per minute

[Term]
id: PREFER:0000056
name: nitrogen flow
def: "Rate at which nitrogen is supplied into the fermenter in form of a ammonium solution." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000172 ! liters per minute

[Term]
id: PREFER:0000057
name: oxygen flow
def: "Rate at which oxygen is supplied to the fermenter." [PREFER]
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000172 ! liters per minute

[Term]
id: PREFER:0000058
name: inlet air o2
def: "Percentaje of oxygen in the gas mixture that is being supplied into the fermenter." [PREFER]
is_a: PREFER:0000009 ! process variable
synonym: "inlet air oxygen" EXACT []
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000187 ! percent

[Term]
id: PREFER:0000059
name: inlet air co2
def: "Percentaje of carbon dioxide in the gas mixture that is being supplied into the fermenter." [PREFER]
is_a: PREFER:0000009 ! process variable
synonym: "inlet air carbon dioxide" EXACT []
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000187 ! percent

[Term]
id: PREFER:0000060
name: OD
def: "Optical density to measure biomass. Absorbance is the logarithm of the ratio of incident to transmitted radiant power through a sample (excluding the effects on cell walls)" [PREFER]
synonym: "optical density" EXACT []
synonym: "OD600" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000154 ! offline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000189 ! dimensionless unit

[Term]
id: PREFER:0000061
name: OUR
def: "Inline determination of the rate at which O2 is consumed by cells." [PREFER]
synonym: "o2 uptake rate" EXACT []
synonym: "oxygen uptake rate" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000171 ! millimole per hour

[Term]
id: PREFER:0000062
name: CER
def: "Inline determination of the rate at which CO2 is produced by cells." [PREFER]
synonym: "co2 evolution rate" EXACT []
synonym: "carbon dioxide evolution rate" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000171 ! millimole per hour

[Term]
id: PREFER:0000063
name: OTR
def: "Rate at which O2 is transferred from the gas phase or fermenter air into the liquid phase within a fermenter." [PREFER] 
synonym: "oxygen transfer rate" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000170 ! mole per hour

[Term]
id: PREFER:0000064
name: CTR
def: "Rate at which CO2 is transferred out of the fermenter." [PREFER]
comment: "Important as CO2 is considered a by-product in aerobic processes, and so is a parameter used for predicting biomass concentration, evaluating energetic efficiencies of growth, monitoring growth yields and controlling fed batch processes like airflow rates or stir speeds." [PREFER]
synonym: "carbon dioxide transfer rate" EXACT []
is_a: PREFER:0000157 ! rate
relationship: PREFER_RE:has_possible_unit: PREFER_UNIT:0000170 ! mole per hour

[Term]
id: PREFER:0000065
name: RQ
def: "Respiratory Quotient: Ratio of CO2 produced to O2 consumed during cellular metabolism throught the bioprocess/run. Used to assess the metabolic state of cells." [PREFER]
is_a: PREFER:0000159 ! respiratory metric
relationship: PREFER_RE:has_possible_unit: UO:0000189 ! dimensionless unit

[Term]
id: PREFER:0000066
name: produced co2
def: "Amount of CO2 generated during the bioprocess." [PREFER]
synonym: "produced carbon dioxide" EXACT []
synonym: "formed co2" EXACT []
synonym: "formed carbon dioxide" EXACT []
is_a: PREFER:0000158 ! respiratory metric
relationship: PREFER_RE:has_possible_unit: UO:0000013 ! mole

[Term]
id: PREFER:0000067
name: consumed co2
def: "Amount of CO2 consumed during the bioprocess." [PREFER]
synonym: "consumed oxygen" EXACT []
is_a: PREFER:0000158 ! respiratory metric
relationship: PREFER_RE:has_possible_unit: UO:0000013 ! mole

[Term]
id: PREFER:0000068
name: offgas co2
def: "The percentage of CO2 present in the exhaust stream leaving the fermenter, indicating the amount of CO2 produced." [PREFER]
synonym: "offgas carbon dioxide" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000187 ! percent

[Term]
id: PREFER:0000069
name: offgas o2
def: "The percentage of O2 present in the exhaust stream leaving of the fermenter, indicating how much oxygen has been consumed." [PREFER]
synonym: "offgas oxygen" EXACT []
is_a: PREFER:0000009 ! process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! inline measurement
relationship: PREFER_RE:has_possible_unit: UO:0000187 ! percent

[Term]
id: PREFER:0000070
name: gas concentration
def: "Concentration of the gas compound(substrate (ingredient), product or by-product) in the bioprocess." [PREFER]
comment: "Gases such as O2 and CO2 are considered compounds but independently."
is_a: PREFER:0000010 ! compound
