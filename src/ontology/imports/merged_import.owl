AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0002329> "Stage IA2 (FIGO)")
ClassAssertion(<http://purl.obolibrary.org/obo/OBI_0002326> <http://purl.obolibrary.org/obo/OBI_0002329>)

