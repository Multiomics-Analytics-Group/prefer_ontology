# Class: obo:PREFER_0000008 (cultivation condition)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PREFER") obo:IAO_0000115 obo:PREFER_0000008 "An environmental setting or an initial experimental condition related to inoculation established prior to or at the start of a fermentation process.")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000008 "AFO_/property#AFX:0001732")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000008 "EDAM:3724")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000008 "precision_fermentation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PREFER_0000008 "environmental setting")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PREFER_0000008 "incoulation condition")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PREFER_0000008 "reference value")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PREFER_0000008 "setpoint value")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PREFER_0000008 "target variable")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000008 "PREFER:0000008")
AnnotationAssertion(rdfs:comment obo:PREFER_0000008 "\"This condition, which may be categorical or scalar variable, can include key environmental setpoints such as pH, temperature, initial volume, and optical density (OD) of the seed culture.\"")
AnnotationAssertion(rdfs:label obo:PREFER_0000008 "cultivation condition")
SubClassOf(obo:PREFER_0000008 obo:XCO_0000000)
SubClassOf(obo:PREFER_0000008 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PREFER_0000015))

# Class: obo:PREFER_0000009 (process variable)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PREFER") obo:IAO_0000115 obo:PREFER_0000009 "A technical parameter measured during a bioprocess, either through real-time (online, inline) or delayed (offline, atline) measurements, depending on the bioreactor setup. These variables are typically time-series data and are crucial for controlling and adjusting the initial parameters from cultivation conditions.")
AnnotationAssertion(prefer1:BROADER obo:PREFER_0000009 "bioprocess observed variable")
AnnotationAssertion(prefer1:BROADER obo:PREFER_0000009 "measured variable")
AnnotationAssertion(prefer1:BROADER obo:PREFER_0000009 "observed variable")
AnnotationAssertion(prefer1:BROADER obo:PREFER_0000009 "variable")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000009 "BAO:0002070")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PREFER_0000009 "bioprocess measured variable")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PREFER_0000009 "bioprocess variable")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000009 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000009 "PREFER:0000009")
AnnotationAssertion(rdfs:comment obo:PREFER_0000009 "\"These data typically include compound groups categorized as substrates, products, by-products, and chemical ingredients from the medium.\"")
AnnotationAssertion(rdfs:label obo:PREFER_0000009 "process variable")

