[Term]
id: PREFER:7000004
name: carbon mole per carbon mole
namespace: precision_fermentation
def: "A unit representing a carbon-based ratio, typically used to express product, output substance or input - such as biomass, compound and substrate -  in carbon moles per carbon mole of biomass generated, initial material consumed or input substrate consumed (cmol/cmol)." []
synonym: "c-mol/c-mol" EXACT []
synonym: "carbon mole per carbon mole" RELATED []
synonym: "cmol/cmol" EXACT []
is_a: PREFER:9000004 ! unit
relationship: PREFER:8000021 PREFER:7000002 ! has denominator unit carbon mole
relationship: PREFER:8000022 PREFER:7000002 ! has numerator unit carbon mole

[Term]
id: PREFER:7000005
name: carbon mole per hour
namespace: precision_fermentation
def: "A unit of mass flow rate representing a carbon mole of substance passing through a given surface or system in one hour (cmol/h)." []
synonym: "c-mol/h" EXACT []
synonym: "carbon mole per hour" RELATED []
synonym: "cmol/h" EXACT []
is_a: PREFER:9000004 ! unit
relationship: PREFER:8000021 uom:h ! has denominator unit hour
relationship: PREFER:8000022 PREFER:7000002 ! has numerator unit carbon mole

