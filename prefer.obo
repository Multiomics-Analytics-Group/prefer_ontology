is_a: PREFER:0000008 ! cultivation condition
relationship: has_culture_type PREFER:0000201 ! pre-optional culture
relationship: has_culture_type PREFER:0000202 ! pre-final culture
relationship: has_culture_type PREFER:0000203 ! main culture
property_value: culture:id " " xsd:string

[Term]
id: PREFER:0000011
name: medium
def: "An aqueous solution containing macronutrients, micronutrients and buffering agents." [PREFER]
synonym: "culture medium" EXACT [OBI:0000079]
xref: BAO:0000114
xref: EFO:0000579
xref: OBI:0000079
relationship: has_ingredient CHEBI:24431 ! chemical entity

[Term]
id: PREFER:0000012
name: strain
def: "An isolate or group of isolates that can be distinguished from other isoletes of the same species by phenotypic and/or genotypic characteristics." [doi:10.1093/jaoac/85.2.524, PREFER]
comment: "Strain and subtype are often used interchangeably, although the term strain is often used to describe a set of isolates with common biochemical and/or physiological characteristics, while the term subtype is often used to describe a set of isolates with common genetic or molecular characteristics." [doi:10.1093/jaoac/85.2.524, PREFER]
synonym: "subtype" EXACT [doi:10.1093/jaoac/85.2.524]
xref: NCBITaxon:strain
is_a: NCBITaxon_:taxonomic_rank

[Term]
id: PREFER:0000013
name: taxon
def: "A specific taxa within the database, generally species, but it could also be genus, family, order, class, phylum, kingdom, and domain." [PREFER]
xref: NCBITaxon:1
is_a: NCBITaxon:131567

[Term]
id: PREFER:0000014
name: bioreactor
def: "A device or system that supports a biologically active environemnt to run a bioprocess, including lab-scale, pilot plant, and industrial-scale systems." [OBI:0001046, PREFER]
synonym: "bioreactor system" EXACT []
synonym: "fermenter" NARROW [MSIO:0000167]
xref: OBI:0001046
is_a: BAO_0003118 ! instrument
relationship: has_operational_mode PREFER:0000181 ! batch
relationship: has_operational_mode PREFER:0000182 ! fed-batch
relationship: has_operational_mode PREFER:0000183 ! continuous-chemostat
relationship: has_operational_mode PREFER:0000184 ! continuous-turbidostat
relationship: has_scale PREFER:0000186 ! lab-scale
relationship: has_scale PREFER:0000187 ! pilot-scale
relationship: has_scale PREFER:0000188 ! industrial-scale

[Term]
id: PREFER:0000015
name: operational parameter
def: "An operational setting related to the operational mode of the bioreactor and the type of fermentation or cultivation carried out." [PREFER]
comment: "Such as dissolved oxygen (DO) control setpoints and feeding strategies." [PREFER]
synonym: "parameter" RELATED [NCIT:C44175, REPR:Parameter]
synonym: "setting" RELATED [AFR:0001505]
xref: REPR:InstrumentSetting

[Term]
id: PREFER:0000016
name: phase
def: "A time interval of a fermentation process." [PREFER]

[Term]
id: PREFER:0000017
name: event
def: "An operational intervention set by user that triggers the start or end of the fermentation phase." [PREFER]

[Term]
id: PREFER:0000018
name: offline sample
def: "A sample taken from the bioreactor at a specific time point during the fermentation run for subsequent offline analysis of various compounds, such as substrates, products, and by-products, and biomass." [PREFER]
synonym: "collected sample" EXACT []
synonym: "sample" EXACT [SIO]
is_a: SIO:001050

[Term]
id: PREFER:0000019
name: temperature setpoint
def: "The target temperature value to be maintained within the bioreactor." [PREFER]
synonym: "target temperature" EXACT [PREFER]
synonym: "target temperature value" EXACT [PREFER]
synonym: "temperature control setpoint" EXACT [PREFER]
synonym: "temperature reference point" EXACT [PREFER]
synonym: "temperature reference value" EXACT [PREFER]
