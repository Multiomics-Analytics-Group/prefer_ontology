synonym: "target temperature" EXACT [PREFER]
synonym: "target Tº" EXACT [PREFER]
synonym: "temperature control setpoint" EXACT [PREFER]
synonym: "temperature reference point" EXACT [PREFER]
synonym: "temperature reference value" EXACT [PREFER]
synonym: "target temperature value" EXACT [PREFER]
