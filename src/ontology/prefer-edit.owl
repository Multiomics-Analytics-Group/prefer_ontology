# Class: obo:PREFER_0000001 (precision fermentation process)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PREFER") obo:IAO_0000115 obo:PREFER_0000001 "A biotechnological method used in industrial or research settings that employs genetically engineered or adaptatively evolved(ALE) microorganisms (such as bacteria, yeast, fungi or microalgae) to produce specific, high-value compounds with precise molecular structures. This process involves controlled environments—such as operating bioreactor parameters(e.g., temperature, pH, dissolved oxygen, agitation, nutrient feed) and upstream preparation conditions(e.g., pre-culture growth, strain storage, and defined media composition)—where microbial metabolism is optimized to synthesize target products, such as proteins, enzymes, or bioactive molecules, often with greater efficiency, yield, and specificity than traditional fermentation methods.")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000001 "GO:0006113")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000001 "OBI_0000011")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000001 "SRAO_/SRAO:0000223")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000001 "Wikipedia:Industrial_fermentation#Precision_fermentation")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000001 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000001 "PREFER:0000001")
AnnotationAssertion(rdfs:comment obo:PREFER_0000001 "\"Root of all fermentation terms in the Precision Fermentation Ontology.\"")
AnnotationAssertion(rdfs:label obo:PREFER_0000001 "precision fermentation process")
SubClassOf(obo:PREFER_0000001 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PREFER_0000002))

# Class: obo:PREFER_0000002 (fermentation project)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PREFER") obo:IAO_0000115 obo:PREFER_0000002 "A single fermentation experiment or multiple related experiments conducted within a research group.")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000002 "OBI_0000066")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PREFER_0000002 "project")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000002 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000002 "PREFER:0000002")
AnnotationAssertion(rdfs:label obo:PREFER_0000002 "fermentation project")
SubClassOf(obo:PREFER_0000002 obo:PREFER_0000001)
SubClassOf(obo:PREFER_0000002 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PREFER_0000003))

# Class: obo:PREFER_0000003 (fermentation experiment)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PREFER") obo:IAO_0000115 obo:PREFER_0000003 "A set of fermentation runs conducted within the same project, all following a shared experimental approach or protocol.")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000003 "OBI_0000070")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PREFER_0000003 "experiment")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000003 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000003 "PREFER:0000003")
AnnotationAssertion(rdfs:label obo:PREFER_0000003 "fermentation experiment")
SubClassOf(obo:PREFER_0000003 obo:PREFER_0000002)
SubClassOf(obo:PREFER_0000003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PREFER_0000004))

# Class: obo:PREFER_0000004 (fermentation run)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PREFER") obo:IAO_0000115 obo:PREFER_0000004 "An individual instance of a precision fermentation process carried out under defined experimental conditions (e.g., temperature, pH, agitation) using a single bioreactor system.")
AnnotationAssertion(oboInOwl:hasDbXref obo:PREFER_0000004 "CHMO:0001624")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PREFER_0000004 "run")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PREFER_0000004 "precision_fermentation")
AnnotationAssertion(oboInOwl:id obo:PREFER_0000004 "PREFER:0000004")
AnnotationAssertion(rdfs:label obo:PREFER_0000004 "fermentation run")
