    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017"/>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030"/>
    


    <!-- http://purl.obolibrary.org/obo/PREFER_9000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PREFER_9000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <obo:IAO_0000115>A realizable entity that inheres in a system and is realized in processes of controlling or regulating a process, such that it affects or determines the behavior, operation, or outcome of that process.</obo:IAO_0000115>
        <dc:contributor>https://orcid.org/0000-0001-7258-9596</dc:contributor>
        <rdfs:label xml:lang="en">process control variable</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PREFER_9000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PREFER_9000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity about a process that specifically represents measurable attributes or values that are the outcomes of a measurement process aimed at determining characteristics of said process.</obo:IAO_0000115>
        <dc:contributor>https://orcid.org/0000-0001-7258-9596</dc:contributor>
        <rdfs:label xml:lang="en">process measurement variable</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PREFER_9000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PREFER_9000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity about a process that is the output of a calculation or computation based on one or more measured or other input variables, representing derived or computed attributes related to the process.</obo:IAO_0000115>
        <dc:contributor>https://orcid.org/0000-0001-7258-9596</dc:contributor>
        <rdfs:label xml:lang="en">process calculated variable</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PREFER_9000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PREFER_9000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A process that involves precision fermentation.</obo:IAO_0000115>
        <rdfs:comment>Precision fermentation is a biotechnological method used in industrial or research settings that employs genetically engineered or adaptatively evolved(ALE) microorganisms (such as bacteria, yeast, fungi or microalgae) to produce specific, high-value compounds with precise molecular structures. This process involves controlled environments—such as operating bioreactor parameters(e.g., temperature, pH, dissolved oxygen, agitation, nutrient feed) and upstream preparation conditions(e.g., pre-culture growth, strain storage, and defined media composition)—where microbial metabolism is optimized to synthesize target products, such as proteins, enzymes, or bioactive molecules, often with greater efficiency, yield, and specificity than traditional fermentation methods.</rdfs:comment>
        <rdfs:label xml:lang="en">precision fermentation process</rdfs:label>
    </owl:Class>
</rdf:RDF>



