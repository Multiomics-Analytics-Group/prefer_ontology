format-version: 1.2
data-version: prefer/releases/v0_2025-09-01
default-namespace: precisionfermentation
ontology: prefer.obo

[Term]
id: PREFER:0000001
name: precision fermentation process
def: "A biotechnological method used in industrial or research settings that employs genetically engineered microorganisms (such as 
bacteria, yeast, or fungi) to produce specific, high-value compounds with precise molecular structures. This process involves controlled 
environments (e.g., controlled bioreactors, environmental conditions) where microbial metabolism is optimized to synthesize target products, such as proteins, enzymes, or bioactive molecules, often 
with greater efficiency and specificity than traditional fermentation methods."
comment: "Root of all fermentation terms in the Precision Fermentation Ontology."
xref: GO:0006113 ! fermentation
xref: Wikipedia: Industrial fermentation#Precision fermentation
xref: OBI_0000011 ! planned process

[Term]
id: PREFER:0000002
name: fermentation run
def: "An individual instance of a precision fermentation process carried out under defined experimental conditions (e.g., temperature, pH, agitation) using a single bioreactor system."
synonym: "run" EXACT []
is_a: PREFER:0000001 ! precision fermentation process
relationship: has_measured_cultivation_condition PREFER:0000008 ! cultivation condition
relationship: has_measured_process_variable PREFER:0000009 ! process variable

[Term]
id: PREFER:0000003
name: fermentation experiment
def: "A set of fermentation runs conducted within the same project, all following a shared experimental approach or protocol."
synonym: "experiment" EXACT []
has_part: PREFER:0000002 ! fermentation run
is_a: PREFER:0000001 ! precision fermentation process
xref: OBI_0000070 ! assay

[Term]
id: PREFER:0000004
name: fermentation project
def: "A single fermentation experiment or multiple related experiments conducted within a research group."
synonym: "project" EXACT []
has_part: PREFER:0000003 ! fermentation experiment
is_a: PREFER:0000001 ! precision fermentation process
xref: OBI_0000066 ! investigation

/*
[Term]
id: PREFER:0000005
name: User
def: "The individual assigned as the project manager."
is_a: PREFER:0000001 ! precision fermentation process


[Term]
id: PREFER:0000006
name: Institution
def: "The public or private research center, university, or organization that hosts or supports the execution of the project."


[Term]
id: PREFER:0000007
name: Country
def: "The state or nation where the project is carried out."
is_a: PREFER:0000001 ! precision fermentation process
*/

[Term]
id: PREFER:0000008
name: cultivation condition
def: "An initial experimental parameter or environmental setting established prior to or at the start of a fermentation process. This condition, which may be categorical or scalar variable, can include key environmental setpoints such as pH, temperature, initial volume, and optical density (OD) of the seed culture"
synonym: "process variable" RELATED []


[Term]
id: PREFER:0000009
name: process variable
def: "A technical parameter measured during a bioprocess, either through real-time (online, inline) or delayed (offline, atline) measurements, depending on the bioreactor setup. These variables are typically time-series data and are crucial for controlling and adjusting the initial parameters from cultivation conditions."
synonym: "variable" RELATED []
xref: BAO_0002070 ! measured value

[Term]
id: PREFER:0000010
name: compound
def:  "A chemical substance produced, consumed, or measured during fermentation."
is_a: CHEBI:24431 ! chemical entity

[Term]
id: PREFER:0000011
name: medium
def: "A solution containing macronutrients, micronutrients and buffering agents."
relationship: has_ingredient PREFER:0000010 ! compound

[Term]
id: PREFER:0000012
name: strain
def: "A distinct microbial strain within the database."
xref: NCBI_Taxon:Strain
is_a: NCBI_Taxon:taxonomic rank

[Term]
id: PREFER:0000013
name: taxon
def: "A specific taxa within the database, generally species, but it could also be genus, family, order, class, phylum, kingdom, and domain."
is_a: PREFER:0000001 ! precision fermentation process
xref: NCBITaxon:1 ! root
is_a: NCBITaxon:131567 ! cellular organisms

[Term]
id: PREFER:0000014
name: fermenter
def: "Concrete type of bioreactor environment where the fermentation occurs."
synonym: "Bioreactor" EXACT []
synonym: "Bioreactor system" EXACT []
is_a: BAO:0003118 ! instrument

[Term]
id: PREFER:0000015
name: Phase
def: "A fermentation phase."
is_a: PREFER:0000001 ! precision fermentation process

[Term]
id: PREFER:0000016
name: Event
def: "A fermentation event that triggers the fermentation phase to start or end."
is_a: PREFER:0000001 ! precision fermentation process

[Term]
id: PREFER:0000017
name: iModulon
def: "An iModulon unit symbolizes a distinct iModulon activity from the iModulon database. An iModulon is an independently modulated group of genes, often representing the effect of a transcriptional regulator."
is_a: PREFER:0000001 ! precision fermentation process

[Term]
id: PREFER:0000018
name: 







[Term]
id: PREFER:0000019
name: temperature setpoint (C)
def: "The target temperature value to be maintained within the fermenter, expressed in degrees Celsius (ºC)."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000041 ! Temperature 

[Term]
id: PREFER:0000020
name: pH setpoint
def: "Target pH value to be maintained within the fermenter throught the process."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 

[Term]
id: PREFER:0000021
name: pH control base solution
def: "The alkaline (base) solution used to control and maintain the pH within the fermenter, when it reaches below the setpoint."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 

[Term]
id: PREFER:0000022
name: pH control acid solution
def: "The acidic solution used to control and maintain the pH within the fermenter, when it rises above the setpoint."
synonym:
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 

[Term]
id: PREFER:0000023
name: culture
def: "Starter culture id or initial culture referring to the strain ID."
is_a: PREFER:0000008 ! Cultivation condition

[Term]
id: PREFER:0000024
name: seed
def: "Starter culture or initial culture prepared from a stock culture and cultivated in smaller volume (either tubes, shake flasks or reactors) until a certain concentration is reached. The starter culture is also referred as a seed culture, pre-culture or inoculum."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000022 ! Culture 

[Term]
id: PREFER:0000025
name: DO control setpoint (%)
def: "The target value for dissolved oxygen (DO), in percent."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000026
name: DO control cascade level 1
def: "First level of the cascade control system for dissolved oxygen. Level 1 involves adjusting the stirrer_speed parameter to ahcieve the desired DO level."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000027
name: maximum stirring
def: "The maximum revolutions per minute (rpm) of the bioreactor stirrer."
is_a: PREFER:0000008 ! Cultivation condition
synonym: "maximum shaking speed" EXACT []
relationship: related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000028
name: Minimum Stirring or Shaking Speed (rpm)
def: "The minimum revolutions per minute (rpm) of the bioreactor stirrer."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000029
name: DO Control Cascade Level 2
def: "Second level of the cascade control system for dissolved oxygen. Level 2 involves adjusting the air_flow parameter to ahcieve the desired DO level."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000030
name: Aeration Gas Type
def: "Type of gas used for aeration in the bioreactor, which may include aire or specific gases such as pure oxygen or nitrogen."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000031
name: Maximum Aeration (slpm)
def: "Maximum rate of at which gas can be supplied to the fermenter, measured in slpm (standard liters per minute)."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000032
name: Minimum Aeration (slpm)
def: "Minimum rate of at which gas can be supplied to the fermenter, measured in slpm (standard liters per minute)."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000033
name: DO Control Cascade Level 3
def: "Third level of the cascade control system for dissolved oxygen. Level 3 involves adjusting the o2_flow parameter to ahcieve the desired DO level."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 

[Term]
id: PREFER:0000034
name: Starting OD
def: "The initial optical density (OD) of the fermentation. It is either measured (by taking a sample after inoculation and measuring the cell density) or  calculated (by knowing the final OD of the seed culture, volume inoculated and final cultivation volume)."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000060 ! OD 

[Term]
id: PREFER:0000035
name: Final Seed OD
def: "The cell density of the seed culturre at the time it is inoculated to the main fermenter."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000060 ! OD 

[Term]
id: PREFER:0000036
name: Initial Culture Volume
def: "The total volume of the culture at the beginning of the bioprocess, representing the sum of culture medium and inoculum, no units."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000022 ! Culture 

[Term]
id: PREFER:0000037
name: Culture Volume Unit
def: "The unit of measurement for the culture volume, in mL."
is_a: PREFER:0000008 ! Cultivation condition
relationship: PREFER_RE:related_to PREFER:0000022 ! Culture 

[Term]
id: PREFER:0000038
name: Feed profile
def: "Feeding strategies typically found in a fed-batch fermentation. 1. Constant feeding rate, 2. Linear feeding rate and 3. Exponential feeding rate, 4. Combination of 1-2, 3-2 or 3-1 . The type of feeding profiles applied is process specific."
is_a: PREFER:0000008 ! Cultivation condition

[Term]
id: PREFER:0000039
name: DO
def: "Dissolved oxygen (DO) refers to the concentration of oxygen molecules (O₂) dissolved in a liquid medium, typically measured in bioreactors or aquatic systems."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000040
name: pH
def: "Bioreactor Potential of Hydrogen (pH) reading. Logarithmic scale used to specify the acidity or basicity of aqueous solutions."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000041
name: Temperature
def: "Bioreactor temperature reading. Pyhsical quantity that quantitatively expresses the attribute of hotness or coldness, reflecting the average kinetic energy of the vibrating and colliding atoms making up a substance."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000042
name: Pressure
def: "Bioreactor pressure reading."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000043
name: Volume
def: "Total volume of liquid in the fermenter, measured in L."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000044
name: Sample mass
def: "The mass of the sample taken from the run, measured in grams. Implemented for quantifying the amount of biomass, product, other compounds."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000154 ! Offline measurement

/*
[Term]
id: PREFER:0000045
name: Sample volume
def: "The volume of the sample taken from the bioprocess/run, measured in mL. Implemented for calculating concentrations, dilutions, etc."
is_a: PREFER:0000017 ! Computed variable

[Term]
id: PREFER:0000046
name: Accumulated sample volume
def: "Total volume of all samples taken from the bioprocess/run up to a certain point in time, measured in mL."
is_a: PREFER:0000017 ! Computed variable
/*

[Term]
id: PREFER:0000047
name: Acid volume
def: "Volume of the acidic solution pumped into the fermenter, measured  in L."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000048
name: Base volume
def: "Volume of the concentration base solution pumped into the fermenter to maintain the pH of cultivation at a constant level, measured  in L."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000040 ! pH 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000049
name: Acid rate
def: "The flow rate at which the acid solution is pumped into the fermenter, measured in L/h."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! Feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000050
name: Base rate
def: "The flow rate at which the base solution is pumped into the fermenter, measured in L/h."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! Feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000051
name: Feed amount
def: "The quantity or total mass of feed added to the bioprocess, measured in kg."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:related_to PREFER:0000038 ! Feed profile
relationship: PREFER_RE:is_performance_variable PREFER:0000157 ! Rate

[Term]
id: PREFER:0000052
name: Feed volume
def: "The volume of the feed solution pumped to the bioprocess at a certain time point, measured in L."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! Feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000053
name: Feed rate volumetric 
def: "Rate at which the feed (based on its volume) is added to the bioprocess, measured in L/h."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000038 ! Feed profile
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000054
name: Stirrer speed 
def: "Speed at which the impeller shaft rotates, measured in rpm (revolutions per minute)."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000055
name: Air flow
def: "Rate at which air is supplied to the fermnter, measured in lpm (liters per minute)"
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000056
name: Nitrogen flow
def: "Rate at which nitrogen is supplied to the fermenter, measured in lpm (liters per minute)."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000057
name: Oxygen flow
def: "Rate at which oxygen is supplied to the fermenter, measured in lpm (liters per minute)."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000058
name: Inlet air O2
def: "Percentaje of oxygen in the gas mixture that is being supplied into the fermenter."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000059
name: Inlet air CO2
def: "Percentaje of carbon dioxide in the gas mixture that is being supplied into the fermenter."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:related_to PREFER:0000039 ! DO 
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000060
name: OD
def: "OD600. Optical density to measure biomass. Absorbance is the logarithm of the ratio of incident to transmitted radiant power through a sample (excluding the effects on cell walls)"
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000154 ! Offline measurement

[Term]
id: PREFER:0000061
name: O2 uptake rate
def: "Oxygen Uptake Rate: Online determination of the rate at which O2 is consumed by cells. Ambr records it as unnormalized in mmol/h, with factor 0.001"
synonym: "OUR" EXACT []
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000062
name: CO2 evolution rate
def: "Online determination of the rate at which CO2 is produced by cells. Ambr records it as unnormalized in mmol/h, with factor 0.001."
synonym: "CER" EXACT []
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000063
name: OTR
def: "Oxygen Transfer Rate (mol/h): rate at which O2 is transferred from the gas phase or fermenter air into the liquid phase within a fermenter."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000157 ! Rate

[Term]
id: PREFER:0000064
name: CTR
def: "Carbon dioxide Transfer Rate (mol/h): rate at which CO2 is transferred out of the fermenter. Important as CO2 is considered a by-product in aerobic processes, and so is a parameter used for predicting biomass concentration, evaluating energetic efficiencies of growth, monitoring growth yields and controlling fed batch processes like airflow rates or stir speeds."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000157 ! Rate

[Term]
id: PREFER:0000065
name: RQ
def: "Respiratory Quotient: Ratio of CO2 produced to O2 consumed during cellular metabolism throught the bioprocess/run, dimensionless number. Used to assess the metabolic state of cells."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000158 ! Respiratory metrics

[Term]
id: PREFER:0000066
name: Formed CO2
def: "Amount of CO2 generated during the bioprocess. Ambr records it as unnormalized, integrated, in moles."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000158 ! Respiratory metrics

[Term]
id: PREFER:0000067
name: Consumed CO2
def: "Amount of O2 consumed during the bioprocess. Ambr records it as unnormalized, integrated, in moles."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000158 ! Respiratory metrics

[Term]
id: PREFER:0000068
name: Offgas CO2
def: "The percentage of CO2 present in the exhaust stream leaving the fermenter, indicating the amount of CO2 produced."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000069
name: Offgas O2
def: "The percentage of O2 present in the exhaust stream leaving of the fermenter, indicating how much oxygen has been consumed."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000151 ! Inline measurement

[Term]
id: PREFER:0000070
name: Compound
def: "Concentration of the compound(substrate (ingredient), product or by-product) in the bioprocess, measured in g/L. Gases such as O2 and CO2 are considered compounds but independently."
is_a: PREFER:0000010 ! Compound
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000154 ! Offline measurement

[Term]
id: PREFER:0000071
name: Biomass concentration
def: "Concentration of the biomass, measured in g/L."
is_a: PREFER:0000009 ! Process variable
relationship: PREFER_RE:has_data_acquisition_mode PREFER:0000154 ! Offline measurement

/*
[Term]
id: PREFER:0000072
name: Volume Added
def: "It is the actual final volume that has been added." 
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:related_to REFER:0000043 ! Volume

[Term]
id: PREFER:0000073
name: Liquid volume downscaled
def: "It is the actual volume at a certain time point where sampling was performed."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:related_to REFER:0000043 ! Volume

[Term]
id: PREFER:0000074
name: Liquid volume (without corrected samples)
def: "Total volume of liquid in the fermenter without subtracting the sample volume extracted, measured in L."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:related_to REFER:0000043 ! Volume

[Term]
id: PREFER:0000075
name: Volume Unit
def: "The unit for the additional volume added, categorical variable normally in mL."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:related_to REFER:0000043 ! Volume

[Term]
id: PREFER:0000076
name: Volume to Add None 
def: "The volume that must be added ro reach a certain starting OD in the reactor, scalar variable pre-calculated."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:related_to REFER:0000043 ! Volume
/*

[Term]
id: PREFER:0000077
name: Dilution rate (D)
def: "The rate at which fresh medium is fed into a main culture relative to the culture volume, representing the rate at which the culture is diluted, measured in 1/h."
synonym: D EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000157 ! Rate

[Term]
id: PREFER:0000078
name: Carbon balance
def: "Balance which compares the total amount of carbon entering the fermenter (through the substrate) to the total carbon leaving the fermenter (in products, biomass or by.products like CO2), expressed in percentage."
synonym: C balance EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000159 ! Respiratory metrics

[Term]
id: PREFER:0000079
name: Carbon balance using carbon mols
def: "The carbon balance calculated using carbon moles (c-mols), providing more molecular level view of the carbon flow, no units."
synonym: C balance (c-mols) EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000159 ! Respiratory metrics

[Term]
id: PREFER:0000080
name: Carbon balance with reference to substrate
def: "The carbon balance specifically referenced to the substrate usedin the bioprocess, to asses substrate utilization efficiency. No units."
synonym: carbon balance to substrate EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000159 ! Respiratory metrics

[Term]
id: PREFER:0000081
name: Degree of reduction balance
def: "Degree of Reduction (DoR) balance, important for understanding the redox balance in the bioprocess. The balance ensures that the electrons entering the bioprocess are equal to the electrons leaving it. It is expressed in percentage."
synonym: DoR balance EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000156 ! Yield

[Term]
id: PREFER:0000082
name: Degree of reduction yields
def: "The degree of reduction calculated based on the yields of different products. This helps understand how efficiently the system is converting substrate into desired products, taking into account the redox state of each component.  No units."
synonym: DoR yields EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000156 ! Yield

[Term]
id: PREFER:0000083
name: Substrate consumed
def: "The total amount of substrate consumed by the cells during the bioprocess, expressed in g."
is_a: PREFER:0000017 ! Computed variable

[Term]
id: PREFER:0000084
name: Substrate consumed molar
def: "The total amount of substrate consumed by the cells during the bioprocess, expressed in moles."
is_a: PREFER:0000017 ! Computed variable

[Term]
id: PREFER:0000085
name: Substrate consumed carbon molar
def: "The total amount of substrate consumed by the cells during the bioprocess, expressed in c-mols."
is_a: PREFER:0000017 ! Computed variable

/*
[Term]
id: PREFER:0000086
name: Substrate lost in sampling
def: "The amount of substrate removed from the run durning sampling, expressed in g."
is_a: PREFER:0000017 ! Computed variable
/*

[Term]
id: PREFER:0000087
name: Substrate uptake rate
def: "Substrate uptake rate (qs). The rate at which substrate is consumed by the cells, expressed in g/h."
synonym: QS EXACT []
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000157 ! Rate

[Term]
id: PREFER:0000088
name: Substrate uptake rate molar
def: "The rate at which substrate is consumed by the cells, expressed in mol/h."
is_a: PREFER:0000017 ! Computed variable
relationship: PREFER_RE:is_performance_variable PREFER:0000157 ! Rate

[Term]
id: PREFER:0000089
name: Substrate specific uptake rate
def: "The rate of substrate uptake per unit of biomass, expressed in grams of substrate per grams of dry biomass per hour (g/g(DW)*h)."
is_a: PREFER:0000017 ! Computed variable
