is_a: PREFER:0000091 ! process titer metric
relationship: BAO_0002874 uom:g.L-1 ! gram per litre

[Term]
id: PREFER:0000075
name: gravimetric feed rate
namespace: precision_fermentation
def: "A process measurement variable that indicates the amount of feed fed per unit time or the mass flow rate of the feed solution added to a bioreactor or fermentation system during a process.\"" []
