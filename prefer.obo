inverse_of: OBI:0000312 ! is specified output of

[Typedef]
id: OBI:0000312
name: is specified output of
def: "A relation between a completely executed planned process and a continuant participating in that process. The presence of the continuant at the end of the process is explicitly specified in the objective specification which the process realizes the concretization of." []
range: COB:0000035 ! completely executed planned process
is_a: RO:0000056 ! participates in

[Typedef]
id: OBI:0000417
name: achieves_planned_objective
def: "This relation obtains between a planned process and a objective specification when the criteria specified in the objective specification are met at the end of the planned process." []
domain: COB:0000035 ! completely executed planned process
range: IAO:0000005 ! objective specification
inverse_of: OBI:0000833 ! objective_achieved_by

[Typedef]
id: OBI:0000833
name: objective_achieved_by
def: "This relation obtains between an objective specification and a planned process when the criteria specified in the objective specification are met at the end of the planned process." []
domain: IAO:0000005 ! objective specification
range: COB:0000035 ! completely executed planned process

[Typedef]
id: OBI:0001938
name: has value specification
def: "A relation between an information content entity and a value specification that specifies its value." []
domain: IAO:0000030 ! information content entity
range: OBI:0001933 ! value specification
